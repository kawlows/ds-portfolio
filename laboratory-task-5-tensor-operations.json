 torch.manual_seed(seed)","key":"lAqw7tW5VP"},{"type":"outputs","id":"Vd_GXrHZ3KrqVYhy4ONry","children":[],"key":"IxjDInKP9v"}],"key":"crfJO5J9Eg"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"3. Random NumPy Array","key":"jj6vIKBUnv"}],"key":"gsQSnKgMkd"}],"identifier":"id-3-random-numpy-array","label":"3. Random NumPy Array","html_id":"id-3-random-numpy-array","implicit":true,"key":"lb9LR3JQu0"},{"type":"paragraph","children":[{"type":"inlineCode","value":"np.random.randint(low, high, size)","key":"C18iGM8qvG"},{"type":"text","value":" draws from ","key":"vBQluBn6Bc"},{"type":"inlineCode","value":"low","key":"edaQ27erQn"},{"type":"text","value":" (inclusive) up to ","key":"dBODVD2DOD"},{"type":"inlineCode","value":"high","key":"yUU7hlWlKh"},{"type":"text","value":" (exclusive), which matches the \"0 (inclusive) and 5 (exclusive)\" wording of the instructions. The dtype is set to ","key":"rsLBrIOuv1"},{"type":"inlineCode","value":"int32","key":"ODYENn5Opf"},{"type":"text","value":" on purpose here — step 5 asks to change the tensor's dtype from ","key":"zF8u3qHgvF"},{"type":"inlineCode","value":"int32","key":"Fa58IQCcMS"},{"type":"text","value":" to ","key":"ikF29F50w8"},{"type":"inlineCode","value":"int64","key":"hJPkVrj9dH"},{"type":"text","value":" later, and that only makes sense to demonstrate if the array (and the tensor made from it) is actually ","key":"YgxQ6gSppx"},{"type":"inlineCode","value":"int32","key":"hHkNRTe1Ye"},{"type":"text","value":" to begin with.","key":"FJS76PL5mj"}],"key":"UouTHggVfN"}],"key":"onh3mLABQO"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.205492Z","iopub.status.busy":"2026-09-21T13:51:23.205271Z","iopub.status.idle":"2026-09-21T13:51:23.220116Z","shell.execute_reply":"2026-09-21T13:51:23.218634Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_