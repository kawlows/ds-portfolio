 ","key":"gUA0YHqbRN"},{"type":"inlineCode","value":"x.pow_(2)","key":"xbWqKSeHE2"},{"type":"text","value":", would overwrite ","key":"TUXTRAFaUx"},{"type":"inlineCode","value":"x","key":"cEwJY4cPdH"},{"type":"text","value":", which is exactly what the instructions say not to do — printing ","key":"M48Q93O14Y"},{"type":"inlineCode","value":"x","key":"QGnAPluX1Z"},{"type":"text","value":" again afterward confirms it is still the original 3×2 tensor.","key":"x7tZAG0dpA"}],"key":"vr9eKeFVJM"}],"key":"v8DtZzlpVz"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.251544Z","iopub.status.busy":"2026-09-21T13:51:23.251363Z","iopub.status.idle":"2026-09-21T13:51:23.256452Z","shell.execute_reply":"2026-09-21T13:51:23.255431Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x_squared = x.pow(2)\nprint(\"Squared:\")\nprint(x_squared)\n\nprint(\"\\nx is unchanged:\")\nprint(x)","key":"QR6n4imCxd"},{"type":"outputs","id":"cwV-crwseNWP4xPU4ynzF","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Squared:\ntensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\nx is unchanged:\ntensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n"},"children":[],"key":"M85eW0QSSe"}],"key":"JYRQOOxnOX"}],"key":"CwTslZNecn"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"9. Building ","key":"Vshcnk0jiQ"},{"type":"inlineCode","value":"y","key":"HRlgJlCKmC"},{"type":"text","value":" for Matrix Multiplication","key":"relsUm0N2K"}],"key":"rW8Yx2e4ys"}],"identifier":"id-9-building-y-for-matrix-multiplication","label":"9. Building y for Matrix Multiplication","html_id":"id-9-building-y-for-matrix-multiplication","implicit":true,"key":"oN5CuBAc3t"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x","key":"AIbPZCz0NG"},{"type":"text","value":" is (3, 2). For ","key":"qwYaSMZavJ"},{"type":"inlineCode","value":"x @ y","key":"oc6HuJHLvq"},{"type":"text","value":" to be valid, ","key":"gLKcH57Vap"},{"type":"inlineCode","value":"y","key":"ReAttCE180"},{"type":"text","value":"'s first dimension has to match ","key":"faaACkV4Vd"},{"type":"inlineCode","value":"x","key":"KZZSThrb23"},{"type":"text","value":"'s second dimension, i.e. 2 rows. The instructions also ask for the same number of elements as ","key":"pwcBfOAHGJ"},{"type":"inlineCode","value":"x","key":"MJLTVlrdbc"},{"type":"text","value":", which is 6, so ","key":"uYrHDMXG2D"},{"type":"inlineCode","value":"y","key":"cwmhUJ9PZ8"},{"type":"text","value":" has to be (2, 3): 2 rows to satisfy matrix multiplication, times 3 columns to reach 6 elements. ","key":"DjWpfNj7dB"},{"type":"inlineCode","value":"torch.randint(low, high, size)","key":"dNQDbm0U7j"},{"type":"text","value":" is the PyTorch equivalent of the NumPy call used for ","key":"m1fzy6IgpB"},{"type":"inlineCode","value":"arr","key":"GMSTC8qev8"},{"type":"text","value":" earlier, and the seed is reset to 42 right before it so this cell produces the same values on every run.","key":"z6mCUlaqTP"}],"key":"mxPnZ1AYqF"}],"key":"SXlCks4m0a"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.258464Z","iopub.status.busy":"2026-09-21T13:51:23.258244Z","iopub.status.idle":"2026-09-21T13:51:23.265106Z","shell.execute_reply":"2026-09-21T13:51:23.263738Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_seed(42)\ny = torch.randint(0, 5, (2, 3))\nprint(y)\nprint(y.shape)","key":"DYiEgnEYIq"},{"type":"outputs","id":"zR-9va73dRo4J-DJPNxF9","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[2, 2, 1],\n        [4, 1, 0]])\ntorch.Size([2, 3])\n"},"children":[],"key":"vDl2ux1onH"}],"key":"aVGGYsXpKZ"}],"key":"W0oxhIwHZY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"10. Matrix Product of ","key":"RYdWIL9vvr"},{"type":"inlineCode","value":"x","key":"tDwHuYiBGn"},{"type":"text","value":" and ","key":"BJJxVjZadw"},{"type":"inlineCode","value":"y","key":"Ptg9uT9aY1"}],"key":"WjuCJfGn3A"}],"identifier":"id-10-matrix-product-of-x-and-y","label":"10. Matrix Product of x and y","html_id":"id-10-matrix-product-of-x-and-y","implicit":true,"key":"Km3tBWrdCA"},{"type":"paragraph","children":[{"type":"text","value":"With ","key":"qo6FCm1Y6O"},{"type":"inlineCode","value":"x","key":"WqeLY0xzOv"},{"type":"text","value":" at (3, 2) and ","key":"ROehSbKBVe"},{"type":"inlineCode","value":"y","key":"ZE4Y6FLV6W"},{"type":"text","value":" at (2, 3), ","key":"BdfNMIkhUr"},{"type":"inlineCode","value":"torch.mm(x, y)","key":"oryzaUAvzC"},{"type":"text","value":" (equivalently ","key":"lftYvwI9Dj"},{"type":"inlineCode","value":"x @ y","key":"DmYjhE92oQ"},{"type":"text","value":" or ","key":"olECyRFwQc"},{"type":"inlineCode","value":"x.mm(y)","key":"v1Oo69eldP"},{"type":"text","value":") produces a (3, 3) result, following the same rule covered earlier in the notebook: an (a, b) tensor times a (b, c) tensor gives an (a, c) tensor.","key":"lhfA22p4qH"}],"key":"LwNzkvFLcs"}],"key":"fNWNehmfmQ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.267044Z","iopub.status.busy":"2026-09-21T13:51:23.266853Z","iopub.status.idle":"2026-09-21T13:51:23.272115Z","shell.execute_reply":"2026-09-21T13:51:23.270988Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"product = torch.mm(x, y)\nprint(product)\nprint(product.shape)","key":"HTvyvgvFIf"},{"type":"outputs","id":"Fcl2uTxfMT0zmuG5gQM75","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\ntorch.Size([3, 3])\n"},"children":[],"key":"nPA0ANQAgI"}],"key":"LdBufV3PsT"}],"key":"TNpwNpmUJF"}],"