 torch.manual_seed(seed)","key":"WsZLVqxLXA"},{"type":"outputs","id":"BQbza4WlWO4ZhPSQmb8vx","children":[],"key":"v0F2LzIJts"}],"key":"youRifQVKj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"3. Random NumPy Array","key":"HGEGiHw8r6"}],"key":"j65ZpiNo6e"}],"identifier":"id-3-random-numpy-array","label":"3. Random NumPy Array","html_id":"id-3-random-numpy-array","implicit":true,"key":"wxm0q486LG"},{"type":"paragraph","children":[{"type":"inlineCode","value":"np.random.randint(low, high, size)","key":"UHJQlm3kIx"},{"type":"text","value":" draws from ","key":"Y6ZauPrV6g"},{"type":"inlineCode","value":"low","key":"GI4GvXm07K"},{"type":"text","value":" (inclusive) up to ","key":"os2LFgFs7L"},{"type":"inlineCode","value":"high","key":"iLlRTCehEy"},{"type":"text","value":" (exclusive), which matches the \"0 (inclusive) and 5 (exclusive)\" wording of the instructions. The dtype is set to ","key":"Koh7fbFOVk"},{"type":"inlineCode","value":"int32","key":"L8SKNEx5i9"},{"type":"text","value":" on purpose here — step 5 asks to change the tensor's dtype from ","key":"MibByzbvXG"},{"type":"inlineCode","value":"int32","key":"Mwto6MqH72"},{"type":"text","value":" to ","key":"VETn4JsytN"},{"type":"inlineCode","value":"int64","key":"UNcsUK7QGh"},{"type":"text","value":" later, and that only makes sense to demonstrate if the array (and the tensor made from it) is actually ","key":"WtoO12OG68"},{"type":"inlineCode","value":"int32","key":"XHlAgJbPEM"},{"type":"text","value":" to begin with.","key":"SwO6Z9RG5r"}],"key":"Dskb1nrr3w"}],"key":"ezsNzk0Hcr"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.205492Z","iopub.status.busy":"2026-09-21T13:51:23.205271Z","iopub.status.idle":"2026-09-21T13:51:23.220116Z","shell.execute_reply":"2026-09-21T13:51:23.218634Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_