n with.","key":"TfUDNTcsPn"}],"key":"EfN4SZwZy6"}],"identifier":"0c96f2c8","html_id":"0c96f2c8","key":"DJGcDPA35i"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.205492Z","iopub.status.busy":"2026-09-21T13:51:23.205271Z","iopub.status.idle":"2026-09-21T13:51:23.220116Z","shell.execute_reply":"2026-09-21T13:51:23.218634Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_seed(42)\narr = np.random.randint(0, 5, 6, dtype=np.int32)\nprint(arr)\nprint(arr.dtype)","key":"hinXSyZq2K"},{"type":"outputs","id":"skHC_oFHwR50ZwJJBf4eQ","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[3 4 2 4 4 1]\nint32\n"},"children":[],"key":"frunr6LWDt"}],"key":"taQeMrl24W"}],"identifier":"be7b6042","html_id":"be7b6042","key":"c9N7vBnjT3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"4. Tensor from the NumPy Array","key":"QI4rPclJrq"}],"key":"gGbSzq5FZW"}],"identifier":"id-4-tensor-from-the-numpy-array","label":"4. Tensor from the NumPy Array","html_id":"id-4-tensor-from-the-numpy-array","implicit":true,"key":"PWX0Qy4zRj"},{"type":"paragraph","children":[{"type":"inlineCode","value":"torch.from_numpy()","key":"s8t4Q9K5mJ"},{"type":"text","value":" wraps the existing array without copying it, and it carries the array's dtype over — so ","key":"auGgu6Vg8n"},{"type":"inlineCode","value":"x","key":"orXXwMWpRl"},{"type":"text","value":" starts out as an ","key":"EsW5qjObJZ"},{"type":"inlineCode","value":"int32","key":"yeOrSBeeBy"},{"type":"text","value":" tensor, matching ","key":"l2sZTkpxPB"},{"type":"inlineCode","value":"arr","key":"EJrsqAa9VE"},{"type":"text","value":".","key":"k3JdIHIQqJ"}],"key":"DwcfVpeX0V"}],"identifier":"3d133d1c","html_id":"3d133d1c","key":"uOYf5W3Gnp"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.222575Z","iopub.status.busy":"2026-09-21T13:51:23.222287Z","iopub.status.idle":"2026-09-21T13:51:23.228198Z","shell.execute_reply":"2026-09-21T13:51:23.227266Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x = torch.from_numpy(arr)\nprint(x)\nprint(x.dtype)","key":"hs0bUiLOG6"},{"type":"outputs","id":"ztb3ahPqvMeKGD3bkMQlO","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([3, 4, 2, 4, 4, 1], dtype=torch.int32)\ntorch.int32\n"},"children":[],"key":"QaEqdYbyld"}],"key":"McGBpXmlmZ"}],"identifier":"96bce3ca","html_id":"96bce3ca","key":"yi2pNbYFz8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"5. Changing the dtype","key":"uj8jRA6f6x"}],"key":"L6X2rJI8Xn"}],"identifier":"id-5-changing-the-dtype","label":"5. Changing the dtype","html_id":"id-5-changing-the-dtype","implicit":true,"key":"dlqf5SpXd1"},{"type":"paragraph","children":[{"type":"text","value":"As the notebook's earlier section on dtypes points out, ","key":"cK3z50yEIK"},{"type":"inlineCode","value":"x = torch.tensor(x, dtype=torch.type)","key":"mt10JSWvCb"},{"type":"text","value":" is the wrong way to do this — it triggers a tensor-cloning warning. The correct approach is the ","key":"joZBF9Hr0C"},{"type":"inlineCode","value":".type()","key":"wqstul7R8e"},{"type":"text","value":" method, which returns a new tensor cast to the requested dtype.","key":"Rgs5jUlMxr"}],"key":"gU8P8UEU0V"}],"identifier":"4ea0df70","html_id":"4ea0df70","key":"vU4ppIHY5P"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.230724Z","iopub.status.busy":"2026-09-21T13:51:23.230487Z","iopub.status.idle":"2026-09-21T13:51:23.236280Z","shell.execute_reply":"2026-09-21T13:51:23.235082Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x = x.type(torch.int64)\nprint(x)\nprint(x.dtype)","key":"SeIj51OVyn"},{"type":"outputs","id":"t6XxHDrqOynwC7V3hgSaj","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([3, 4, 2, 4, 4, 1])\ntorch.int64\n"},"children":[],"key":"QvFuvsoKiJ"}],"key":"MLHfHCCXp5"}],"identifier":"366ee701","html_id":"366ee701","key":"IXCkFFOXaW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"6. Reshaping into 3×2","key":"vDtK7k9u4P"}],"key":"pcvUMmyEnh"}],"identifier":"id-6-reshaping-into-3-2","label":"6. Reshaping into 3×2","html_id":"id-6-reshaping-into-3-2","implicit":true,"key":"cIwzg3wi6Z"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x","key":"WXGRj68wgd"},{"type":"text","value":" has 6 elements, so it can be reshaped into any shape whose dimensions multiply to 6 — 3 rows by 2 columns in this case. Either ","key":"ZkpejKq1j0"},{"type":"inlineCode","value":".view()","key":"D45YCZElfb"},{"type":"text","value":" or ","key":"afr1jLRT7G"},{"type":"inlineCode","value":".reshape()","key":"L1bWSyCs84"},{"type":"text","value":" works here since ","key":"PMNlc9g3ch"},{"type":"inlineCode","value":"x","key":"NyX0h6rfdR"},{"type":"text","value":" is contiguous in memory; ","key":"hPecOvOVQG"},{"type":"inlineCode","value":".reshape()","key":"YeZdISZRlZ"},{"type":"text","value":" is used below since it also falls back gracefully to making a copy on tensors where ","key":"STArbVs98n"},{"type":"inlineCode","value":".view()","key":"m6UWiFAVcl"},{"type":"text","value":" would raise an error.","key":"KfoQCxRrJH"}],"key":"v2CrvXXB5S"}],"identifier":"a06d0a63","html_id":"a06d0a63","key":"MrLqfiKnyt"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.238109Z","iopub.status.busy":"2026-09-21T13:51:23.237900Z","iopub.status.idle":"2026-09-21T13:51:23.242803Z","shell.execute_reply":"2026-09-21T13:51:23.241702Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x = x.reshape(3, 2)\nprint(x)\nprint(x.shape)","key":"XMl7wflF3q"},{"type":"outputs","id":"N0_OcpsBqOHTI6ZUfL2Xb","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[3, 4],\n        [2, 4],\n        [4, 1]])\ntorch.Size([3, 2])\n"},"children":[],"key":"V69mhoEmAr"}],"key":"f0GVKUyTNJ"}],"identifier":"65801d07","html_id":"65801d07","key":"v11tXFVvck"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"7. Right-Hand Column","key":"Ra4OeX4eIj"}],"key":"LThm7M9HJ4"}],"identifier":"id-7-right-hand-column","label":"7. Right-Hand Column","html_id":"id-7-right-hand-column","implicit":true,"key":"exDTnHMqPJ"},{"type":"paragraph","children":[{"type":"text","value":"Standard NumPy-style slicing carries over to tensors: ","key":"kHMjNLSGGW"},{"type":"inlineCode","value":"x[:, 1]","key":"DYtbwbrvqy"},{"type":"text","value":" takes every row and column index 1, which is the second (right-hand) column.","key":"BkgXfbf4Pl"}],"key":"G7KsUsmiTd"}],"identifier":"0d47c039","html_id":"0d47c039","key":"jCs8KqetyC"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.244776Z","iopub.status.busy":"2026-09-21T13:51:23.244620Z","iopub.status.idle":"2026-09-21T13:51:23.249607Z","shell.execute_reply":"2026-09-21T13:51:23.248659Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"right_col = x[:, 1]\nprint(right_col)","key":"pIm59xM1NZ"},{"type":"outputs","id":"swWzvETkBnfIB-U0ajuCX","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([4, 4, 1])\n"},"children":[],"key":"HaYqmYJYro"}],"key":"ynNU7CkfNP"}],"identifier":"cf3cdf51","html_id":"cf3cdf51","key":"DXuLnU47MI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"8. Squared Values, Without Changing ","key":"SnnOpFqtgK"},{"type":"inlineCode","value":"x","key":"NngDpwHNU0"}],"key":"hihsHEKA3B"}],"identifier":"id-8-squared-values-without-changing-x","label":"8. Squared Values, Without Changing x","html_id":"id-8-squared-values-without-changing-x","implicit":true,"key":"RaVOfAKSig"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x.pow(2)","key":"ZfUKhd2HWA"},{"type":"text","value":" (equivalently ","key":"t6Jw2xsMTk"},{"type":"inlineCode","value":"x ** 2","key":"Z1uCG8gBhV"},{"type":"text","value":" or ","key":"jPjdRSzw3q"},{"type":"inlineCode","value":"torch.square(x)","key":"lbQCPVrTuK"},{"type":"text","value":") returns a new tensor and leaves ","key":"r0db2Iuap4"},{"type":"inlineCode","value":"x","key":"su5uglYdgq"},{"type":"text","value":" untouched. The in-place version, ","key":"YM6gHCXF0q"},{"type":"inlineCode","value":"x.pow_(2)","key":"DYgepUW0EW"},{"type":"text","value":", would overwrite ","key":"chFhx9BrFX"},{"type":"inlineCode","value":"x","key":"K28iyahL1d"},{"type":"text","value":", which is exactly what the instructions say not to do — printing ","key":"tYPXHM6e4Y"},{"type":"inlineCode","value":"x","key":"cNsqT9PmbH"},{"type":"text","value":" again afterward confirms it is still the original 3×2 tensor.","key":"ddG0u6657U"}],"key":"H1iMih2DPO"}],"identifier":"0febe12f","html_id":"0febe12f","key":"Rh4gGqw5Uy"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.251544Z","iopub.status.busy":"2026-09-21T13:51:23.251363Z","iopub.status.idle":"2026-09-21T13:51:23.256452Z","shell.execute_reply":"2026-09-21T13:51:23.255431Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x_squared = x.pow(2)\nprint(\"Squared:\")\nprint(x_squared)\n\nprint(\"\\nx is unchanged:\")\nprint(x)","key":"ohh85Ykp3O"},{"type":"outputs","id":"gsO2rrwA3HuzZsCc9mTPz","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Squared:\ntensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\nx is unchanged:\ntensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n"},"children":[],"key":"PdC4UFxTAo"}],"key":"X93AdFEqRP"}],"identifier":"0ab79adf","html_id":"0ab79adf","key":"dzLXL4QrC1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"9. Building ","key":"aS0hsj5MkU"},{"type":"inlineCode","value":"y","key":"NDmOYSAbrN"},{"type":"text","value":" for Matrix Multiplication","key":"T1FO8YjcxA"}],"key":"XgADsDINMt"}],"identifier":"id-9-building-y-for-matrix-multiplication","label":"9. Building y for Matrix Multiplication","html_id":"id-9-building-y-for-matrix-multiplication","implicit":true,"key":"XjLQZbp6HB"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x","key":"Zkomwt2ePY"},{"type":"text","value":" is (3, 2). For ","key":"kfjrMQgF7h"},{"type":"inlineCode","value":"x @ y","key":"fhrhDlkQEy"},{"type":"text","value":" to be valid, ","key":"xGGBIZsDNv"},{"type":"inlineCode","value":"y","key":"wVovwPKp0Q"},{"type":"text","value":"'s first dimension has to match ","key":"fLVhTjmDBI"},{"type":"inlineCode","value":"x","key":"PczagOpGef"},{"type":"text","value":"'s second dimension, i.e. 2 rows. The instructions also ask for the same number of elements as ","key":"TkjC2CYVMW"},{"type":"inlineCode","value":"x","key":"EoWus1GpSJ"},{"type":"text","value":", which is 6, so ","key":"AOa3ELAtsK"},{"type":"inlineCode","value":"y","key":"ak0357Bysu"},{"type":"text","value":" has to be (2, 3): 2 rows to satisfy matrix multiplication, times 3 columns to reach 6 elements. ","key":"IHIZYX3IMc"},{"type":"inlineCode","value":"torch.randint(low, high, size)","key":"Y4nc1mXnnF"},{"type":"text","value":" is the PyTorch equivalent of the NumPy call used for ","key":"ibE8Qq6HpS"},{"type":"inlineCode","value":"arr","key":"G8EgGUBW1O"},{"type":"text","value":" earlier, and the seed is reset to 42 right before it so this cell produces the same values on every run.","key":"JymGmJC8tA"}],"key":"vPrVlvor15"}],"identifier":"a5664249","html_id":"a5664249","key":"nZo5zMhJFL"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.258464Z","iopub.status.busy":"2026-09-21T13:51:23.258244Z","iopub.status.idle":"2026-09-21T13:51:23.265106Z","shell.execute_reply":"2026-09-21T13:51:23.263738Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_seed(42)\ny = torch.randint(0, 5, (2, 3))\nprint(y)\nprint(y.shape)","key":"pqiQefRhGI"},{"type":"outputs","id":"D2cpVqS_yOmFaeaIGJO6A","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[2, 2, 1],\n        [4, 1, 0]])\ntorch.Size([2, 3])\n"},"children":[],"key":"l4TudObTYf"}],"key":"mLN7ZGQZnc"}],"identifier":"849420f2","html_id":"849420f2","key":"zWwOSJ4VVd"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"10. Matrix Product of ","key":"uy8fJpLCfO"},{"type":"inlineCode","value":"x","key":"RRHqgaGfvE"},{"type":"text","value":" and ","key":"LOCm4WbFy3"},{"type":"inlineCode","value":"y","key":"slYofkz3ZH"}],"key":"Jo03hqzw4y"}],"identifier":"id-10-matrix-product-of-x-and-y","label":"10. Matrix Product of x and y","html_id":"id-10-matrix-product-of-x-and-y","implicit":true,"key":"Nrf7Qh3QUQ"},{"type":"paragraph","children":[{"type":"text","value":"With ","key":"xyyKZmibFN"},{"type":"inlineCode","value":"x","key":"Cu5HJ8HuzR"},{"type":"text","value":" at (3, 2) and ","key":"jRiSjiG4kM"},{"type":"inlineCode","value":"y","key":"xnRZdsN7Jv"},{"type":"text","value":" at (2, 3), ","key":"QX9swEuX6o"},{"type":"inlineCode","value":"torch.mm(x, y)","key":"fKpJsMN9JV"},{"type":"text","value":" (equivalently ","key":"rRQ7SwYgS8"},{"type":"inlineCode","value":"x @ y","key":"nHkRvwBQqb"},{"type":"text","value":" or ","key":"FTcd2vFh5j"},{"type":"inlineCode","value":"x.mm(y)","key":"QDdsL1K9sU"},{"type":"text","value":") produces a (3, 3) result, following the same rule covered earlier in the notebook: an (a, b) tensor times a (b, c) tensor gives an (a, c) tensor.","key":"K34x5oDjQv"}],"key":"fHY1qh5kMd"}],"identifier":"30f4afd6","html_id":"30f4afd6","key":"U4aef1UcYV"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.267044Z","iopub.status.busy":"2026-09-21T13:51:23.266853Z","iopub.status.idle":"2026-09-21T13:51:23.272115Z","shell.execute_reply":"2026-09-21T13:51:23.270988Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"product = torch.mm(x, y)\nprint(product)\nprint(product.shape)","key":"ebKs1iOndy"},{"type":"outputs","id":"SKYtq9zDPTidmClJhVbf6","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\ntorch.Size([3, 3])\n"},"children":[],"key":"aXnLz33tHO"}],"key":"byAazORiTn"}],"identifier":"b7c79870","html_id":"b7c79870","key":"MbO22Tfoyc"}],"key":"L4skDdoSfw"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Laboratory Task 4 Linear Regression","url":"/laboratory-task-4-linear-regression","group":"Karl Michael Gaca Portfolio"},"next":{"title":"Laboratory Task 6 CNN Architecture","url":"/laboratory-task-6-cnn-architecture","group":"Karl Michael Gaca Portfolio"}}},"domain":"http://localhost:3000"}