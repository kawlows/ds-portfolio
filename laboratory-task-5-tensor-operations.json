 ","key":"Y2tpCCXI9C"},{"type":"inlineCode","value":"x.pow_(2)","key":"Qe7ECc9kJh"},{"type":"text","value":", would overwrite ","key":"aoDJipKl7W"},{"type":"inlineCode","value":"x","key":"NKoJkYZRPn"},{"type":"text","value":", which is exactly what the instructions say not to do — printing ","key":"odknt4gefN"},{"type":"inlineCode","value":"x","key":"fmoRAuFE7D"},{"type":"text","value":" again afterward confirms it is still the original 3×2 tensor.","key":"GHnxh0tcBR"}],"key":"QjaNwvaYrH"}],"key":"qLIhqaYDnT"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.251544Z","iopub.status.busy":"2026-09-21T13:51:23.251363Z","iopub.status.idle":"2026-09-21T13:51:23.256452Z","shell.execute_reply":"2026-09-21T13:51:23.255431Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x_squared = x.pow(2)\nprint(\"Squared:\")\nprint(x_squared)\n\nprint(\"\\nx is unchanged:\")\nprint(x)","key":"ehwiykGL8y"},{"type":"outputs","id":"8Ox5GpxE5zThoaxW-jb-9","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Squared:\ntensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\nx is unchanged:\ntensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n"},"children":[],"key":"yAol8l4RYw"}],"key":"VTnIr61eCa"}],"key":"LmDwsRH4yy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"9. Building ","key":"VbFOHV2jph"},{"type":"inlineCode","value":"y","key":"IPnjSqcATr"},{"type":"text","value":" for Matrix Multiplication","key":"js3pf5x8yQ"}],"key":"zK1XPwl0aq"}],"identifier":"id-9-building-y-for-matrix-multiplication","label":"9. Building y for Matrix Multiplication","html_id":"id-9-building-y-for-matrix-multiplication","implicit":true,"key":"xU4mfhDL6d"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x","key":"ESRNpXrbRS"},{"type":"text","value":" is (3, 2). For ","key":"y5z88cMXL7"},{"type":"inlineCode","value":"x @ y","key":"c6JX3xXyYq"},{"type":"text","value":" to be valid, ","key":"ZWM79e5p2G"},{"type":"inlineCode","value":"y","key":"xYyyRa2izb"},{"type":"text","value":"'s first dimension has to match ","key":"dlCrsnorBs"},{"type":"inlineCode","value":"x","key":"RA4l7xQ13V"},{"type":"text","value":"'s second dimension, i.e. 2 rows. The instructions also ask for the same number of elements as ","key":"JFrK18Rz4a"},{"type":"inlineCode","value":"x","key":"GRY8Vl4Qw3"},{"type":"text","value":", which is 6, so ","key":"bopWm6XFZ0"},{"type":"inlineCode","value":"y","key":"iSANWsDWX9"},{"type":"text","value":" has to be (2, 3): 2 rows to satisfy matrix multiplication, times 3 columns to reach 6 elements. ","key":"KAvcqrEkDQ"},{"type":"inlineCode","value":"torch.randint(low, high, size)","key":"TEBW2oJZmE"},{"type":"text","value":" is the PyTorch equivalent of the NumPy call used for ","key":"tUgMQ0q2sC"},{"type":"inlineCode","value":"arr","key":"xXhIx9FzgD"},{"type":"text","value":" earlier, and the seed is reset to 42 right before it so this cell produces the same values on every run.","key":"eQXTmfQ4QW"}],"key":"jif0OfFlBc"}],"key":"vHKiTl3IVG"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.258464Z","iopub.status.busy":"2026-09-21T13:51:23.258244Z","iopub.status.idle":"2026-09-21T13:51:23.265106Z","shell.execute_reply":"2026-09-21T13:51:23.263738Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_seed(42)\ny = torch.randint(0, 5, (2, 3))\nprint(y)\nprint(y.shape)","key":"rDRUnkt5xm"},{"type":"outputs","id":"Ga2QucqjqJfjh3cCJXA-h","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[2, 2, 1],\n        [4, 1, 0]])\ntorch.Size([2, 3])\n"},"children":[],"key":"MscJr3FnJQ"}],"key":"V34U5YYE35"}],"key":"kUSMJken35"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"