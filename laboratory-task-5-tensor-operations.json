 ","key":"OZygbxbtIx"},{"type":"inlineCode","value":"x.pow_(2)","key":"lmemwVcPzE"},{"type":"text","value":", would overwrite ","key":"GxW9Faibor"},{"type":"inlineCode","value":"x","key":"pdiZGYmyrO"},{"type":"text","value":", which is exactly what the instructions say not to do — printing ","key":"B1z7bNAbGY"},{"type":"inlineCode","value":"x","key":"FqY7IhHI84"},{"type":"text","value":" again afterward confirms it is still the original 3×2 tensor.","key":"xsiiUcD8fq"}],"key":"FvyndPFJVE"}],"key":"HiuhdNEA7n"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.251544Z","iopub.status.busy":"2026-09-21T13:51:23.251363Z","iopub.status.idle":"2026-09-21T13:51:23.256452Z","shell.execute_reply":"2026-09-21T13:51:23.255431Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x_squared = x.pow(2)\nprint(\"Squared:\")\nprint(x_squared)\n\nprint(\"\\nx is unchanged:\")\nprint(x)","key":"mcFjqRpR4i"},{"type":"outputs","id":"Qv2UbIwF8lhJ2zum2QuJS","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Squared:\ntensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\nx is unchanged:\ntensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n"},"children":[],"key":"A0KUxm4CzI"}],"key":"ppB4SOgSmU"}],"key":"vaKOvmM5G3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"9. Building ","key":"VFCi2MfcOe"},{"type":"inlineCode","value":"y","key":"jRAlWCDViS"},{"type":"text","value":" for Matrix Multiplication","key":"bI084YHDGf"}],"key":"zJVzmmPRsA"}],"identifier":"id-9-building-y-for-matrix-multiplication","label":"9. Building y for Matrix Multiplication","html_id":"id-9-building-y-for-matrix-multiplication","implicit":true,"key":"yB3LEdLZzY"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x","key":"eIvfXvpCwx"},{"type":"text","value":" is (3, 2). For ","key":"G3cWpHq1Zs"},{"type":"inlineCode","value":"x @ y","key":"gjjwDh3Cxn"},{"type":"text","value":" to be valid, ","key":"DMMEQcwdAq"},{"type":"inlineCode","value":"y","key":"pQNHlgDB93"},{"type":"text","value":"'s first dimension has to match ","key":"v0Ujr6lAcZ"},{"type":"inlineCode","value":"x","key":"YdAvQGATSs"},{"type":"text","value":"'s second dimension, i.e. 2 rows. The instructions also ask for the same number of elements as ","key":"wBQzDYAr8l"},{"type":"inlineCode","value":"x","key":"AWTtwtvTIB"},{"type":"text","value":", which is 6, so ","key":"xgJwuM6vUJ"},{"type":"inlineCode","value":"y","key":"qm37S0clEC"},{"type":"text","value":" has to be (2, 3): 2 rows to satisfy matrix multiplication, times 3 columns to reach 6 elements. ","key":"Cc0DariGjJ"},{"type":"inlineCode","value":"torch.randint(low, high, size)","key":"F3frA8vGzT"},{"type":"text","value":" is the PyTorch equivalent of the NumPy call used for ","key":"n9IoGb71TC"},{"type":"inlineCode","value":"arr","key":"TuLpGlPTkj"},{"type":"text","value":" earlier, and the seed is reset to 42 right before it so this cell produces the same values on every run.","key":"Hdmp8BXgeY"}],"key":"mr4D7vZSKD"}],"key":"e8GgpClgEh"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.258464Z","iopub.status.busy":"2026-09-21T13:51:23.258244Z","iopub.status.idle":"2026-09-21T13:51:23.265106Z","shell.execute_reply":"2026-09-21T13:51:23.263738Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_seed(42)\ny = torch.randint(0, 5, (2, 3))\nprint(y)\nprint(y.shape)","key":"ZuNxs156LT"},{"type":"outputs","id":"9isTtkGNGpl2XtUCn9nCF","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[2, 2, 1],\n        [4, 1, 0]])\ntorch.Size([2, 3])\n"},"children":[],"key":"fUQRfoWOZm"}],"key":"wXsdxpX6CG"}],"key":"ULnm1VO6a5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"10. Matrix Product of ","key":"RW7REwBccY"},{"type":"inlineCode","value":"x","key":"TycIaUDL13"},{"type":"text","value":" and ","key":"FH1JZyS50S"},{"type":"inlineCode","value":"y","key":"bRhIvzbsdJ"}],"key":"G18DJEHhSU"}],"identifier":"id-10-matrix-product-of-x-and-y","label":"10. Matrix Product of x and y","html_id":"id-10-matrix-product-of-x-and-y","implicit":true,"key":"SEEkoFagNl"},{"type":"paragraph","children":[{"type":"text","value":"With ","key":"NXun9ucJ7D"},{"type":"inlineCode","value":"x","key":"OnJSHrtptQ"},{"type":"text","value":" at (3, 2) and ","key":"Gu67oqMn8c"},{"type":"inlineCode","value":"y","key":"gsJP3hf4jc"},{"type":"text","value":" at (2, 3), ","key":"wTix8h83c9"},{"type":"inlineCode","value":"torch.mm(x, y)","key":"QpxXBB9uPu"},{"type":"text","value":" (equivalently ","key":"sSxQTHrygK"},{"type":"inlineCode","value":"x @ y","key":"kaGax6cEqO"},{"type":"text","value":" or ","key":"LV3HLDNfkD"},{"type":"inlineCode","value":"x.mm(y)","key":"wlINCN2zll"},{"type":"text","value":") produces a (3, 3) result, following the same rule covered earlier in the notebook: an (a, b) tensor times a (b, c) tensor gives an (a, c) tensor.","key":"N4MEYaUodf"}],"key":"sfIkBUWCSe"}],"key":"pYyHmTuWB3"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.267044Z","iopub.status.busy":"2026-09-21T13:51:23.266853Z","iopub.status.idle":"2026-09-21T13:51:23.272115Z","shell.execute_reply":"2026-09-21T13:51:23.270988Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"product = torch.mm(x, y)\nprint(product)\nprint(product.shape)","key":"FGjGz4IulW"},{"type":"outputs","id":"Tjo9ZHNBTSrM9hcMKt1X8","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\ntorch.Size([3, 3])\n"},"children":[],"key":"bwJZmiRgS1"}],"key":"kkdilOmXPd"}],"key":"fgx4wwUZAP"}],"