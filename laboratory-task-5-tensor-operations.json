 ","key":"Ll3Fywue6o"},{"type":"inlineCode","value":"x.pow_(2)","key":"y0rOfonvTg"},{"type":"text","value":", would overwrite ","key":"XyRqEtPeXL"},{"type":"inlineCode","value":"x","key":"DmoOrzmjex"},{"type":"text","value":", which is exactly what the instructions say not to do — printing ","key":"XK4yCz4B0q"},{"type":"inlineCode","value":"x","key":"rtjUuJbHPO"},{"type":"text","value":" again afterward confirms it is still the original 3×2 tensor.","key":"ZAeyCeWytB"}],"key":"dNmB7uIrJO"}],"key":"AB4fWbyvFo"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.251544Z","iopub.status.busy":"2026-09-21T13:51:23.251363Z","iopub.status.idle":"2026-09-21T13:51:23.256452Z","shell.execute_reply":"2026-09-21T13:51:23.255431Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x_squared = x.pow(2)\nprint(\"Squared:\")\nprint(x_squared)\n\nprint(\"\\nx is unchanged:\")\nprint(x)","key":"PtXYkvJC4P"},{"type":"outputs","id":"vKQOOYloXZAX_jfdND-4m","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Squared:\ntensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\nx is unchanged:\ntensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n"},"children":[],"key":"RIZYh4Bv9z"}],"key":"qcUxLe3d1t"}],"key":"VI52rSlfkH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"9. Building ","key":"cmoBo49upC"},{"type":"inlineCode","value":"y","key":"PQcsIRPnla"},{"type":"text","value":" for Matrix Multiplication","key":"riTmXXh1Ol"}],"key":"AKUjYtX4FL"}],"identifier":"id-9-building-y-for-matrix-multiplication","label":"9. Building y for Matrix Multiplication","html_id":"id-9-building-y-for-matrix-multiplication","implicit":true,"key":"G7mRWiIw05"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x","key":"Jo5u8jelsg"},{"type":"text","value":" is (3, 2). For ","key":"ld4Ym4Rer9"},{"type":"inlineCode","value":"x @ y","key":"zMSNQ4SBr1"},{"type":"text","value":" to be valid, ","key":"cKdXqzo8oA"},{"type":"inlineCode","value":"y","key":"k9oUTiosWy"},{"type":"text","value":"'s first dimension has to match ","key":"NhL5hVU8Y7"},{"type":"inlineCode","value":"x","key":"MFDDz6SNR7"},{"type":"text","value":"'s second dimension, i.e. 2 rows. The instructions also ask for the same number of elements as ","key":"VNAGBIIYSc"},{"type":"inlineCode","value":"x","key":"vhfzJldXvS"},{"type":"text","value":", which is 6, so ","key":"wEzMGE04iZ"},{"type":"inlineCode","value":"y","key":"gMRpd8MX48"},{"type":"text","value":" has to be (2, 3): 2 rows to satisfy matrix multiplication, times 3 columns to reach 6 elements. ","key":"kkGE3jzase"},{"type":"inlineCode","value":"torch.randint(low, high, size)","key":"Lck2ZSGRSx"},{"type":"text","value":" is the PyTorch equivalent of the NumPy call used for ","key":"CvdwN1ud0t"},{"type":"inlineCode","value":"arr","key":"lUKYBy12KB"},{"type":"text","value":" earlier, and the seed is reset to 42 right before it so this cell produces the same values on every run.","key":"rgwQHjNgr3"}],"key":"WlEwmL4g1a"}],"key":"xxRHXUtIS8"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.258464Z","iopub.status.busy":"2026-09-21T13:51:23.258244Z","iopub.status.idle":"2026-09-21T13:51:23.265106Z","shell.execute_reply":"2026-09-21T13:51:23.263738Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_seed(42)\ny = torch.randint(0, 5, (2, 3))\nprint(y)\nprint(y.shape)","key":"sZ63oQYPKc"},{"type":"outputs","id":"3yP_XRNj0Z82lXqFvuDqj","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[2, 2, 1],\n        [4, 1, 0]])\ntorch.Size([2, 3])\n"},"children":[],"key":"t8RXZZiSLT"}],"key":"ljM7aYYBgf"}],"key":"cV67EA6Hin"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"10. Matrix Product of ","key":"WkTeYXAGZh"},{"type":"inlineCode","value":"x","key":"o3WIVtzr3p"},{"type":"text","value":" and ","key":"z1QE0sXLx1"},{"type":"inlineCode","value":"y","key":"Mu1sAXN6tB"}],"key":"DjRmiS2tBU"}],"identifier":"id-10-matrix-product-of-x-and-y","label":"10. Matrix Product of x and y","html_id":"id-10-matrix-product-of-x-and-y","implicit":true,"key":"ZAqNnGmp7U"},{"type":"paragraph","children":[{"type":"text","value":"With ","key":"Frs8kAdSoJ"},{"type":"inlineCode","value":"x","key":"lQNCMFFvLk"},{"type":"text","value":" at (3, 2) and ","key":"kqmYTaeqZz"},{"type":"inlineCode","value":"y","key":"vo4kTAcpCW"},{"type":"text","value":" at (2, 3), ","key":"yNhG1QnNAd"},{"type":"inlineCode","value":"torch.mm(x, y)","key":"uePjnSeGkF"},{"type":"text","value":" (equivalently ","key":"eheN99mdVu"},{"type":"inlineCode","value":"x @ y","key":"oxyuhZHrWN"},{"type":"text","value":" or ","key":"FmGkQqU4IY"},{"type":"inlineCode","value":"x.mm(y)","key":"NKv0FA9KhW"},{"type":"text","value":") produces a (3, 3) result, following the same rule covered earlier in the notebook: an (a, b) tensor times a (b, c) tensor gives an (a, c) tensor.","key":"Letk8HYjBs"}],"key":"iVaJwGdt84"}],"key":"EP0kXARJ5T"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.267044Z","iopub.status.busy":"2026-09-21T13:51:23.266853Z","iopub.status.idle":"2026-09-21T13:51:23.272115Z","shell.execute_reply":"2026-09-21T13:51:23.270988Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"product = torch.mm(x, y)\nprint(product)\nprint(product.shape)","key":"AWIlduUm9z"},{"type":"outputs","id":"isexI4vwaeCiB5sJItrap","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\ntorch.Size([3, 3])\n"},"children":[],"key":"R2oQbmukgf"}],"key":"eCZE3l2crm"}],"key":"zmmfA5ktXS"}],"