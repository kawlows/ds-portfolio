 ","key":"Vw7vjL2Q8s"},{"type":"inlineCode","value":"x.pow_(2)","key":"fBItfN99Kd"},{"type":"text","value":", would overwrite ","key":"NtuGDa2I91"},{"type":"inlineCode","value":"x","key":"uGtOxtPklJ"},{"type":"text","value":", which is exactly what the instructions say not to do — printing ","key":"eHLCpG5sPu"},{"type":"inlineCode","value":"x","key":"BlrVzkiyln"},{"type":"text","value":" again afterward confirms it is still the original 3×2 tensor.","key":"vjIrylAVD8"}],"key":"q578nx9uXl"}],"key":"rahOXXEVUF"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.251544Z","iopub.status.busy":"2026-09-21T13:51:23.251363Z","iopub.status.idle":"2026-09-21T13:51:23.256452Z","shell.execute_reply":"2026-09-21T13:51:23.255431Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x_squared = x.pow(2)\nprint(\"Squared:\")\nprint(x_squared)\n\nprint(\"\\nx is unchanged:\")\nprint(x)","key":"HWj2jEoyDU"},{"type":"outputs","id":"048j2NV6xqUJ3RWCPipcz","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Squared:\ntensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\nx is unchanged:\ntensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n"},"children":[],"key":"ICAj9CK5wd"}],"key":"RrIVcxwqMo"}],"key":"wkszsBffAM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"9. Building ","key":"Zp8CLhNLXc"},{"type":"inlineCode","value":"y","key":"fpf8gYfSc0"},{"type":"text","value":" for Matrix Multiplication","key":"bXziCDhSwO"}],"key":"kxTAqvU4FA"}],"identifier":"id-9-building-y-for-matrix-multiplication","label":"9. Building y for Matrix Multiplication","html_id":"id-9-building-y-for-matrix-multiplication","implicit":true,"key":"Xrgh1iKvnU"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x","key":"jCR4IyMqMq"},{"type":"text","value":" is (3, 2). For ","key":"xUFMPuRaKL"},{"type":"inlineCode","value":"x @ y","key":"TrhifWoT4o"},{"type":"text","value":" to be valid, ","key":"hsdCJm3vns"},{"type":"inlineCode","value":"y","key":"xoco1tpyL7"},{"type":"text","value":"'s first dimension has to match ","key":"vWSVcjs9tm"},{"type":"inlineCode","value":"x","key":"frAMnaNkGo"},{"type":"text","value":"'s second dimension, i.e. 2 rows. The instructions also ask for the same number of elements as ","key":"bzvfixziOe"},{"type":"inlineCode","value":"x","key":"qka80D6UVF"},{"type":"text","value":", which is 6, so ","key":"ExoZkdZ8wj"},{"type":"inlineCode","value":"y","key":"zjfLXkLmC4"},{"type":"text","value":" has to be (2, 3): 2 rows to satisfy matrix multiplication, times 3 columns to reach 6 elements. ","key":"XGjCscz9uL"},{"type":"inlineCode","value":"torch.randint(low, high, size)","key":"Z93LLdZ02h"},{"type":"text","value":" is the PyTorch equivalent of the NumPy call used for ","key":"qGA7PRzxt1"},{"type":"inlineCode","value":"arr","key":"EEQPXi2kav"},{"type":"text","value":" earlier, and the seed is reset to 42 right before it so this cell produces the same values on every run.","key":"U6Pqq4RzTe"}],"key":"NcTDuUfnNa"}],"key":"HrX2QGFShZ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.258464Z","iopub.status.busy":"2026-09-21T13:51:23.258244Z","iopub.status.idle":"2026-09-21T13:51:23.265106Z","shell.execute_reply":"2026-09-21T13:51:23.263738Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_seed(42)\ny = torch.randint(0, 5, (2, 3))\nprint(y)\nprint(y.shape)","key":"bQvDWGCr6c"},{"type":"outputs","id":"odvjDqGApUInyPmEVGPsY","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[2, 2, 1],\n        [4, 1, 0]])\ntorch.Size([2, 3])\n"},"children":[],"key":"bJCnduTGr2"}],"key":"a7Z7PCYdGz"}],"key":"y5jDbxN0un"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"10. Matrix Product of ","key":"yMfpMTlJll"},{"type":"inlineCode","value":"x","key":"NriSm8D3x3"},{"type":"text","value":" and ","key":"Z7izISi3H3"},{"type":"inlineCode","value":"y","key":"kE8raTIhXC"}],"key":"WycJxXwpo1"}],"identifier":"id-10-matrix-product-of-x-and-y","label":"10. Matrix Product of x and y","html_id":"id-10-matrix-product-of-x-and-y","implicit":true,"key":"YxdmNdgTx9"},{"type":"paragraph","children":[{"type":"text","value":"With ","key":"xBbkvnH8LK"},{"type":"inlineCode","value":"x","key":"gVPdfEYGEN"},{"type":"text","value":" at (3, 2) and ","key":"iSKcUblW1H"},{"type":"inlineCode","value":"y","key":"NNSkfakg9O"},{"type":"text","value":" at (2, 3), ","key":"YHfZtAqeFD"},{"type":"inlineCode","value":"torch.mm(x, y)","key":"QB9KXcQEUU"},{"type":"text","value":" (equivalently ","key":"v4CS46Nc55"},{"type":"inlineCode","value":"x @ y","key":"z9fr6djorv"},{"type":"text","value":" or ","key":"uyaMSLZtbG"},{"type":"inlineCode","value":"x.mm(y)","key":"uNsB4G2mJu"},{"type":"text","value":") produces a (3, 3) result, following the same rule covered earlier in the notebook: an (a, b) tensor times a (b, c) tensor gives an (a, c) tensor.","key":"fngf5TgX9M"}],"key":"eRVftTEt0q"}],"key":"sinG5jZ6R6"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.267044Z","iopub.status.busy":"2026-09-21T13:51:23.266853Z","iopub.status.idle":"2026-09-21T13:51:23.272115Z","shell.execute_reply":"2026-09-21T13:51:23.270988Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"product = torch.mm(x, y)\nprint(product)\nprint(product.shape)","key":"e5C2XLF3VJ"},{"type":"outputs","id":"h9wy33Oh7BnLFRrvItwOj","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\ntorch.Size([3, 3])\n"},"children":[],"key":"oZZRmbuyN2"}],"key":"w02ShcLLzd"}],"key":"WuIVrkOVHi"}],"