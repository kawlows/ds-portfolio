":" or ","key":"JzYNruUiMF"},{"type":"inlineCode","value":"torch.square(x)","key":"AybgB5RVy6"},{"type":"text","value":") returns a new tensor and leaves ","key":"IIccZ3nPJD"},{"type":"inlineCode","value":"x","key":"Ll3FC0AvA9"},{"type":"text","value":" untouched. The in-place version, ","key":"Csqgl8iSJX"},{"type":"inlineCode","value":"x.pow_(2)","key":"YwCVRjEisP"},{"type":"text","value":", would overwrite ","key":"kwKiHI3qME"},{"type":"inlineCode","value":"x","key":"a3HqII9cUb"},{"type":"text","value":", which is exactly what the instructions say not to do — printing ","key":"wV4k6Ait5b"},{"type":"inlineCode","value":"x","key":"f7b5u0LsuK"},{"type":"text","value":" again afterward confirms it is still the original 3×2 tensor.","key":"RYxwzFMybR"}],"key":"ULw8C6PI71"}],"key":"Mia2XeFoLL"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.251544Z","iopub.status.busy":"2026-09-21T13:51:23.251363Z","iopub.status.idle":"2026-09-21T13:51:23.256452Z","shell.execute_reply":"2026-09-21T13:51:23.255431Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x_squared = x.pow(2)\nprint(\"Squared:\")\nprint(x_squared)\n\nprint(\"\\nx is unchanged:\")\nprint(x)","key":"WECpBVgasP"},{"type":"outputs","id":"jSyN11hXGIK4aJGzDTPyR","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Squared:\ntensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\nx is unchanged:\ntensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n"},"children":[],"key":"qeYbQyaNmD"}],"key":"GyXjrLjWBB"}],"key":"dG7vwP6t5l"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"9. Building ","key":"lBjPDEzDp0"},{"type":"inlineCode","value":"y","key":"G6NF3tTo2V"},{"type":"text","value":" for Matrix Multiplication","key":"cU7Jsh088u"}],"key":"rzoBPpSouB"}],"identifier":"id-9-building-y-for-matrix-multiplication","label":"9. Building y for Matrix Multiplication","html_id":"id-9-building-y-for-matrix-multiplication","implicit":true,"key":"pyMOaYZ9nw"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x","key":"pNsXw4z6fm"},{"type":"text","value":" is (3, 2). For ","key":"vofx7WrXVP"},{"type":"inlineCode","value":"x @ y","key":"mHKkH3EZgU"},{"type":"text","value":" to be valid, ","key":"fAgpyXVyEj"},{"type":"inlineCode","value":"y","key":"AcHEFLNadR"},{"type":"text","value":"'s first dimension has to match ","key":"MZdJW3jocc"},{"type":"inlineCode","value":"x","key":"i25ZmDonit"},{"type":"text","value":"'s second dimension, i.e. 2 rows. The instructions also ask for the same number of elements as ","key":"Qo3HhV5TDc"},{"type":"inlineCode","value":"x","key":"LiFxLKKPM4"},{"type":"text","value":", which is 6, so ","key":"L1X2TpTJP8"},{"type":"inlineCode","value":"y","key":"xo1gIQEPl0"},{"type":"text","value":" has to be (2, 3): 2 rows to satisfy matrix multiplication, times 3 columns to reach 6 elements. ","key":"JjZwEQmRa2"},{"type":"inlineCode","value":"torch.randint(low, high, size)","key":"icJqiuh0au"},{"type":"text","value":" is the PyTorch equivalent of the NumPy call used for ","key":"l4kxPz4kKF"},{"type":"inlineCode","value":"arr","key":"ARYJf7wEUc"},{"type":"text","value":" earlier, and the seed is reset to 42 right before it so this cell produces the same values on every run.","key":"lRH2rPShwu"}],"key":"MBADMKQwP6"}],"key":"lOL3VZPSgY"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.258464Z","iopub.status.busy":"2026-09-21T13:51:23.258244Z","iopub.status.idle":"2026-09-21T13:51:23.265106Z","shell.execute_reply":"2026-09-21T13:51:23.263738Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_seed(42)\ny = torch.randint(0, 5, (2, 3))\nprint(y)\nprint(y.shape)","key":"SjHVPHtyjx"},{"type":"outputs","id":"6fhbDBujyvZimfVCliZpA","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[2, 2, 1],\n        [4, 1, 0]])\ntorch.Size([2, 3])\n"},"children":[],"key":"MwxnUW04FV"}],"key":"u7UuYvGFgH"}],"key":"i0MOXlmEAl"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"10. Matrix Product of ","key":"lrpM8oAb9j"},{"type":"inlineCode","value":"x","key":"Lv4CxmX9mS"},{"type":"text","value":" and ","key":"OEQABS7pYx"},{"type":"inlineCode","value":"y","key":"AzZlpFgHLH"}],"key":"graWNW6edG"}],"identifier":"id-10-matrix-product-of-x-and-y","label":"10. Matrix Product of x and y","html_id":"id-10-matrix-product-of-x-and-y","implicit":true,"key":"XWAgUz4jht"},{"type":"paragraph","children":[{"type":"text","value":"With ","key":"M9VC6fNJ3I"},{"type":"inlineCode","value":"x","key":"TVykq9BwCF"},{"type":"text","value":" at (3, 2) and ","key":"ejRDuc8kaJ"},{"type":"inlineCode","value":"y","key":"gwSLZ9O20E"},{"type":"text","value":" at (2, 3), ","key":"cZb6SeTL3r"},{"type":"inlineCode","value":"torch.mm(x, y)","key":"AYbE4gkIxS"},{"type":"text","value":" (equivalently ","key":"hsCrN8RQF2"},{"type":"inlineCode","value":"x @ y","key":"w7SRCpkAHo"},{"type":"text","value":" or ","key":"NM0Xj99kbH"},{"type":"inlineCode","value":"x.mm(y)","key":"Cm7RE4Vw5r"},{"type":"text","value":") produces a (3, 3) result, following the same rule covered earlier in the notebook: an (a, b) tensor times a (b, c) tensor gives an (a, c) tensor.","key":"ZP1yG6O31u"}],"key":"cZtO2oIOhd"}],"key":"lJgwv4kviv"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.267044Z","iopub.status.busy":"2026-09-21T13:51:23.266853Z","iopub.status.idle":"2026-09-21T13:51:23.272115Z","shell.execute_reply":"2026-09-21T13:51:23.270988Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"product = torch.mm(x, y)\nprint(product)\nprint(product.shape)","key":"ndyMPE29VW"},{"type":"outputs","id":"d6T5SGBGucaI9qPlOwpCw","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\ntorch.Size([3, 3])\n"},"children":[],"key":"OZLiurQuUv"}],"key":"FLOtHGs523"}],"key":"IZD8WcoaDu"}],"key":"eLvWqlz3zV"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Laboratory Task 4 Linear Regression","url":"/laboratory-task-4-linear-regression","group":"Karl Michael Gaca Portfolio"},"next":{"title":"Laboratory Task 6 CNN Architecture","url":"/laboratory-task-6-cnn-architecture","group":"Karl Michael Gaca Portfolio"}}},"domain":"http://localhost:3000"}