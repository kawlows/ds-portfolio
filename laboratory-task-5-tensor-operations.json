IBcsN3C"},{"type":"inlineCode","value":"x.pow_(2)","key":"xiHjYDQbya"},{"type":"text","value":", would overwrite ","key":"Z4JZiARZ8T"},{"type":"inlineCode","value":"x","key":"ZYPMAcA0Jc"},{"type":"text","value":", which is exactly what the instructions say not to do — printing ","key":"RxO9O8yJ0P"},{"type":"inlineCode","value":"x","key":"eLgDdgZKu9"},{"type":"text","value":" again afterward confirms it is still the original 3×2 tensor.","key":"wzllxgf6oD"}],"key":"GatNNK46Us"}],"key":"VxGZMONOBQ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.251544Z","iopub.status.busy":"2026-09-21T13:51:23.251363Z","iopub.status.idle":"2026-09-21T13:51:23.256452Z","shell.execute_reply":"2026-09-21T13:51:23.255431Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x_squared = x.pow(2)\nprint(\"Squared:\")\nprint(x_squared)\n\nprint(\"\\nx is unchanged:\")\nprint(x)","key":"R4YwJW6i5s"},{"type":"outputs","id":"xaMdK-hQ1rZ3C15CiUTWz","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Squared:\ntensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\nx is unchanged:\ntensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n"},"children":[],"key":"OHMh5iROQN"}],"key":"Nmv7j1qfVn"}],"key":"kENN14X1GO"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"9. Building ","key":"QsU6OsxfOs"},{"type":"inlineCode","value":"y","key":"fvlPoFCmLt"},{"type":"text","value":" for Matrix Multiplication","key":"bGVqTmob9D"}],"key":"nFWZYZY2iX"}],"identifier":"id-9-building-y-for-matrix-multiplication","label":"9. Building y for Matrix Multiplication","html_id":"id-9-building-y-for-matrix-multiplication","implicit":true,"key":"d8gcq2tzL2"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x","key":"flrfvJwQZ7"},{"type":"text","value":" is (3, 2). For ","key":"AQGwB39TVN"},{"type":