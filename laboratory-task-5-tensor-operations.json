n with.","key":"PB015TbcLZ"}],"key":"UAcocXQUeY"}],"identifier":"0c96f2c8","html_id":"0c96f2c8","key":"O17pt81p8P"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.205492Z","iopub.status.busy":"2026-09-21T13:51:23.205271Z","iopub.status.idle":"2026-09-21T13:51:23.220116Z","shell.execute_reply":"2026-09-21T13:51:23.218634Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_seed(42)\narr = np.random.randint(0, 5, 6, dtype=np.int32)\nprint(arr)\nprint(arr.dtype)","key":"PU6kMildAW"},{"type":"outputs","id":"h89ZVdvfB1gcmPLK2IL_S","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[3 4 2 4 4 1]\nint32\n"},"children":[],"key":"xTYMbWMUu5"}],"key":"bjhixGMhKs"}],"identifier":"be7b6042","html_id":"be7b6042","key":"rkt9BxcCbW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"4. Tensor from the NumPy Array","key":"goFlUT7BxO"}],"key":"mx74toskEf"}],"identifier":"id-4-tensor-from-the-numpy-array","label":"4. Tensor from the NumPy Array","html_id":"id-4-tensor-from-the-numpy-array","implicit":true,"key":"ND46HJ7rYN"},{"type":"paragraph","children":[{"type":"inlineCode","value":"torch.from_numpy()","key":"suZtVVbaud"},{"type":"text","value":" wraps the existing array without copying it, and it carries the array's dtype over — so ","key":"ye6wQkbzsn"},{"type":"inlineCode","value":"x","key":"fX7rknirsI"},{"type":"text","value":" starts out as an ","key":"tylv5hNxq4"},{"type":"inlineCode","value":"int32","key":"MaFt6vDm8P"},{"type":"text","value":" tensor, matching ","key":"Jy9yF9TnGJ"},{"type":"inlineCode","value":"arr","key":"EbDTCkrz1I"},{"type":"text","value":".","key":"rkQpclqEcG"}],"key":"vScvEtGX1u"}],"identifier":"3d133d1c","html_id":"3d133d1c","key":"LcVstq4vxs"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.222575Z","iopub.status.busy":"2026-09-21T13:51:23.222287Z","iopub.status.idle":"2026-09-21T13:51:23.228198Z","shell.execute_reply":"2026-09-21T13:51:23.227266Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x = torch.from_numpy(arr)\nprint(x)\nprint(x.dtype)","key":"OZvQZmu8Qk"},{"type":"outputs","id":"2yEVG-pM-I6tIMQNf8KDU","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([3, 4, 2, 4, 4, 1], dtype=torch.int32)\ntorch.int32\n"},"children":[],"key":"uh8rJ2Medo"}],"key":"oQRV8eTgdz"}],"identifier":"96bce3ca","html_id":"96bce3ca","key":"iy866oUFHl"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"5. Changing the dtype","key":"JR8syUTM9O"}],"key":"KOC9JkIW2U"}],"identifier":"id-5-changing-the-dtype","label":"5. Changing the dtype","html_id":"id-5-changing-the-dtype","implicit":true,"key":"rRgaXKkiAw"},{"type":"paragraph","children":[{"type":"text","value":"As the notebook's earlier section on dtypes points out, ","key":"VtYOuepP6U"},{"type":"inlineCode","value":"x = torch.tensor(x, dtype=torch.type)","key":"GvgBKYe0OD"},{"type":"text","value":" is the wrong way to do this — it triggers a tensor-cloning warning. The correct approach is the ","key":"zppiDURh91"},{"type":"inlineCode","value":".type()","key":"hAXcP2GpfP"},{"type":"text","value":" method, which returns a new tensor cast to the requested dtype.","key":"A3ehDi9mlW"}],"key":"qIClaSSn7W"}],"identifier":"4ea0df70","html_id":"4ea0df70","key":"ynKKquiPdW"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.230724Z","iopub.status.busy":"2026-09-21T13:51:23.230487Z","iopub.status.idle":"2026-09-21T13:51:23.236280Z","shell.execute_reply":"2026-09-21T13:51:23.235082Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x = x.type(torch.int64)\nprint(x)\nprint(x.dtype)","key":"VbkQpqGuL6"},{"type":"outputs","id":"Bo4mQEOC69A0_kOmD81M-","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([3, 4, 2, 4, 4, 1])\ntorch.int64\n"},"children":[],"key":"S5wfZwiqI2"}],"key":"Vju88aDwup"}],"identifier":"366ee701","html_id":"366ee701","key":"gCpGCNxzjI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"6. Reshaping into 3×2","key":"kPzhXE9m6D"}],"key":"eEkSzWyZ50"}],"identifier":"id-6-reshaping-into-3-2","label":"6. Reshaping into 3×2","html_id":"id-6-reshaping-into-3-2","implicit":true,"key":"OS5V8euM4Y"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x","key":"MorPexRbG4"},{"type":"text","value":" has 6 elements, so it can be reshaped into any shape whose dimensions multiply to 6 — 3 rows by 2 columns in this case. Either ","key":"Er6yi51vEb"},{"type":"inlineCode","value":".view()","key":"wQOkfGcXCC"},{"type":"text","value":" or ","key":"HJaKEC9rl6"},{"type":"inlineCode","value":".reshape()","key":"btbNvTzSrE"},{"type":"text","value":" works here since ","key":"qRYYQgrgRV"},{"type":"inlineCode","value":"x","key":"lsJgbiTSFP"},{"type":"text","value":" is contiguous in memory; ","key":"oHuXrL1i5r"},{"type":"inlineCode","value":".reshape()","key":"Hu4DV3OMtR"},{"type":"text","value":" is used below since it also falls back gracefully to making a copy on tensors where ","key":"buyG1ahuXy"},{"type":"inlineCode","value":".view()","key":"cjJY4wpN4q"},{"type":"text","value":" would raise an error.","key":"f5quWqCY64"}],"key":"LX8cSzaItQ"}],"identifier":"a06d0a63","html_id":"a06d0a63","key":"mK1agQajSL"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.238109Z","iopub.status.busy":"2026-09-21T13:51:23.237900Z","iopub.status.idle":"2026-09-21T13:51:23.242803Z","shell.execute_reply":"2026-09-21T13:51:23.241702Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x = x.reshape(3, 2)\nprint(x)\nprint(x.shape)","key":"aj5PZO5ckQ"},{"type":"outputs","id":"bNutkoe-s-GySvEVt8Ci7","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[3, 4],\n        [2, 4],\n        [4, 1]])\ntorch.Size([3, 2])\n"},"children":[],"key":"jB8p3MIV7g"}],"key":"FPkC8cpf9o"}],"identifier":"65801d07","html_id":"65801d07","key":"oSYWhAg5ah"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"7. Right-Hand Column","key":"DCoZEmgStH"}],"key":"L7HIyI7LoA"}],"identifier":"id-7-right-hand-column","label":"7. Right-Hand Column","html_id":"id-7-right-hand-column","implicit":true,"key":"tSEM1Esxou"},{"type":"paragraph","children":[{"type":"text","value":"Standard NumPy-style slicing carries over to tensors: ","key":"lIUQeW2zjb"},{"type":"inlineCode","value":"x[:, 1]","key":"rdtowcG102"},{"type":"text","value":" takes every row and column index 1, which is the second (right-hand) column.","key":"DQj9q2ssX8"}],"key":"WvBNe4T57i"}],"identifier":"0d47c039","html_id":"0d47c039","key":"Fx75CfWGd7"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.244776Z","iopub.status.busy":"2026-09-21T13:51:23.244620Z","iopub.status.idle":"2026-09-21T13:51:23.249607Z","shell.execute_reply":"2026-09-21T13:51:23.248659Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"right_col = x[:, 1]\nprint(right_col)","key":"l54WgPosUZ"},{"type":"outputs","id":"c0gXlJ0awcXkcTT_S-o63","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([4, 4, 1])\n"},"children":[],"key":"hadFZrTlmH"}],"key":"lNi3gzFA0S"}],"identifier":"cf3cdf51","html_id":"cf3cdf51","key":"YIsDF7kAhD"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"8. Squared Values, Without Changing ","key":"HgUHJ9Hi0v"},{"type":"inlineCode","value":"x","key":"mPWbi0akqo"}],"key":"r6I3xQKpvD"}],"identifier":"id-8-squared-values-without-changing-x","label":"8. Squared Values, Without Changing x","html_id":"id-8-squared-values-without-changing-x","implicit":true,"key":"zlS8BcC0Xh"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x.pow(2)","key":"frS2aFPRMJ"},{"type":"text","value":" (equivalently ","key":"IsylrDKd8f"},{"type":"inlineCode","value":"x ** 2","key":"dKhdsj3oLq"},{"type":"text","value":" or ","key":"sxfswZRkIT"},{"type":"inlineCode","value":"torch.square(x)","key":"WSmhwvuqrJ"},{"type":"text","value":") returns a new tensor and leaves ","key":"GDo0WAtvhl"},{"type":"inlineCode","value":"x","key":"j6DknQQuHL"},{"type":"text","value":" untouched. The in-place version, ","key":"bIfSMA5er2"},{"type":"inlineCode","value":"x.pow_(2)","key":"xhYjUTUYU6"},{"type":"text","value":", would overwrite ","key":"aHCcU7BmtJ"},{"type":"inlineCode","value":"x","key":"hsZcL8VaLf"},{"type":"text","value":", which is exactly what the instructions say not to do — printing ","key":"rSm54dOQEb"},{"type":"inlineCode","value":"x","key":"xbkmNMTMhJ"},{"type":"text","value":" again afterward confirms it is still the original 3×2 tensor.","key":"ccwnRHGhwl"}],"key":"A0L3KZu5Nr"}],"identifier":"0febe12f","html_id":"0febe12f","key":"rlZVJ2fBO3"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.251544Z","iopub.status.busy":"2026-09-21T13:51:23.251363Z","iopub.status.idle":"2026-09-21T13:51:23.256452Z","shell.execute_reply":"2026-09-21T13:51:23.255431Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x_squared = x.pow(2)\nprint(\"Squared:\")\nprint(x_squared)\n\nprint(\"\\nx is unchanged:\")\nprint(x)","key":"RLhfX9AgqR"},{"type":"outputs","id":"e4ciKiVS4f9lcxQzMUzgJ","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Squared:\ntensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\nx is unchanged:\ntensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n"},"children":[],"key":"TPaqegyaWi"}],"key":"oTHkvzwcXu"}],"identifier":"0ab79adf","html_id":"0ab79adf","key":"IVjaihEiXv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"9. Building ","key":"pk7KT4pQKm"},{"type":"inlineCode","value":"y","key":"DqwTScMDYv"},{"type":"text","value":" for Matrix Multiplication","key":"XyDj0LFvC4"}],"key":"Pt5bNxAw5F"}],"identifier":"id-9-building-y-for-matrix-multiplication","label":"9. Building y for Matrix Multiplication","html_id":"id-9-building-y-for-matrix-multiplication","implicit":true,"key":"CnlsxEnbtR"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x","key":"F333W1bU01"},{"type":"text","value":" is (3, 2). For ","key":"EowtF9REJD"},{"type":"inlineCode","value":"x @ y","key":"auEU5EtTM9"},{"type":"text","value":" to be valid, ","key":"e0B0uqAtfs"},{"type":"inlineCode","value":"y","key":"w6ageuT8DC"},{"type":"text","value":"'s first dimension has to match ","key":"aC36HVPUf3"},{"type":"inlineCode","value":"x","key":"ieQ2IzYezn"},{"type":"text","value":"'s second dimension, i.e. 2 rows. The instructions also ask for the same number of elements as ","key":"YTHqoEo9PI"},{"type":"inlineCode","value":"x","key":"P250652zcP"},{"type":"text","value":", which is 6, so ","key":"CjmeFOo8Ew"},{"type":"inlineCode","value":"y","key":"SD7HqPrbWB"},{"type":"text","value":" has to be (2, 3): 2 rows to satisfy matrix multiplication, times 3 columns to reach 6 elements. ","key":"JrwYLbm8Em"},{"type":"inlineCode","value":"torch.randint(low, high, size)","key":"zUPl2YudPq"},{"type":"text","value":" is the PyTorch equivalent of the NumPy call used for ","key":"vyO0GEu86n"},{"type":"inlineCode","value":"arr","key":"aJv5PWGEp0"},{"type":"text","value":" earlier, and the seed is reset to 42 right before it so this cell produces the same values on every run.","key":"ovB5KivF15"}],"key":"qhNysjX9XT"}],"identifier":"a5664249","html_id":"a5664249","key":"dGKqPdKtho"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.258464Z","iopub.status.busy":"2026-09-21T13:51:23.258244Z","iopub.status.idle":"2026-09-21T13:51:23.265106Z","shell.execute_reply":"2026-09-21T13:51:23.263738Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_seed(42)\ny = torch.randint(0, 5, (2, 3))\nprint(y)\nprint(y.shape)","key":"EpMEVVamuf"},{"type":"outputs","id":"sdI8uhVbefphq88zHucTr","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[2, 2, 1],\n        [4, 1, 0]])\ntorch.Size([2, 3])\n"},"children":[],"key":"eviw9nvkD1"}],"key":"gmtillzSL3"}],"identifier":"849420f2","html_id":"849420f2","key":"BLwRtM4Cx2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"10. Matrix Product of ","key":"PCVMiiQmC9"},{"type":"inlineCode","value":"x","key":"c5lZSmRgCz"},{"type":"text","value":" and ","key":"c70P6IFfvA"},{"type":"inlineCode","value":"y","key":"Gs82xDPWdx"}],"key":"oEEMj3fZpE"}],"identifier":"id-10-matrix-product-of-x-and-y","label":"10. Matrix Product of x and y","html_id":"id-10-matrix-product-of-x-and-y","implicit":true,"key":"YgNzZHTkzy"},{"type":"paragraph","children":[{"type":"text","value":"With ","key":"zwMLPqsg4y"},{"type":"inlineCode","value":"x","key":"V8XIefbSgd"},{"type":"text","value":" at (3, 2) and ","key":"Wig5LEsBn9"},{"type":"inlineCode","value":"y","key":"WExJO6jzNb"},{"type":"text","value":" at (2, 3), ","key":"EafpCut9Az"},{"type":"inlineCode","value":"torch.mm(x, y)","key":"DEo1nbYnbO"},{"type":"text","value":" (equivalently ","key":"T6v7AVKARR"},{"type":"inlineCode","value":"x @ y","key":"iBGmg3ofiB"},{"type":"text","value":" or ","key":"EuVtn3YFeq"},{"type":"inlineCode","value":"x.mm(y)","key":"uVzvRqQs39"},{"type":"text","value":") produces a (3, 3) result, following the same rule covered earlier in the notebook: an (a, b) tensor times a (b, c) tensor gives an (a, c) tensor.","key":"IWpsHBWKap"}],"key":"MQjyFnXJC9"}],"identifier":"30f4afd6","html_id":"30f4afd6","key":"W0nARbFH4S"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.267044Z","iopub.status.busy":"2026-09-21T13:51:23.266853Z","iopub.status.idle":"2026-09-21T13:51:23.272115Z","shell.execute_reply":"2026-09-21T13:51:23.270988Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"product = torch.mm(x, y)\nprint(product)\nprint(product.shape)","key":"sPW9VUZZdT"},{"type":"outputs","id":"JyqtFW8NkiGw6RjXKmiFh","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\ntorch.Size([3, 3])\n"},"children":[],"key":"dRJJKJEcpo"}],"key":"TtwOEFhBEH"}],"identifier":"b7c79870","html_id":"b7c79870","key":"Yp8WFLRdh0"}],"key":"oo8LK8cbTB"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Laboratory Task 4 Linear Regression","url":"/laboratory-task-4-linear-regression","group":"Karl Michael Gaca Portfolio"},"next":{"title":"Laboratory Task 6 CNN Architecture","url":"/laboratory-task-6-cnn-architecture","group":"Karl Michael Gaca Portfolio"}}},"domain":"http://localhost:3000"}