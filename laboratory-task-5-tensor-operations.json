 torch.manual_seed(seed)","key":"gx7vDMDBEs"},{"type":"outputs","id":"f4yi-o2VWRI1CK0VJw3ZM","children":[],"key":"e3eb1zmCRi"}],"key":"ATnAYkepro"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"3. Random NumPy Array","key":"wMwMRBKGeC"}],"key":"C9SwDCZzOT"}],"identifier":"id-3-random-numpy-array","label":"3. Random NumPy Array","html_id":"id-3-random-numpy-array","implicit":true,"key":"WGRtT3ajiW"},{"type":"paragraph","children":[{"type":"inlineCode","value":"np.random.randint(low, high, size)","key":"b5YoZVQyaV"},{"type":"text","value":" draws from ","key":"cLRx3hs5MI"},{"type":"inlineCode","value":"low","key":"DV7CnRz42Z"},{"type":"text","value":" (inclusive) up to ","key":"Lc7WauQvVc"},{"type":"inlineCode","value":"high","key":"EHSEhLkLi2"},{"type":"text","value":" (exclusive), which matches the \"0 (inclusive) and 5 (exclusive)\" wording of the instructions. The dtype is set to ","key":"enUMyvUoi6"},{"type":"inlineCode","value":"int32","key":"zvR3qUTdnZ"},{"type":"text","value":" on purpose here — step 5 asks to change the tensor's dtype from ","key":"oBPAbheuhZ"},{"type":"inlineCode","value":"int32","key":"Tuh1gZuY8E"},{"type":"text","value":" to ","key":"i4n4ijseZR"},{"type":"inlineCode","value":"int64","key":"DAG7eHnjGf"},{"type":"text","value":" later, and that only makes sense to demonstrate if the array (and the tensor made from it) is actually ","key":"ZuVWeI19Mp"},{"type":"inlineCode","value":"int32","key":"xjTj7X510L"},{"type":"text","value":" to begin with.","key":"XvfMVMg0YI"}],"key":"bMXHE3LbDL"}],"key":"a6yYQqG3PU"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.205492Z","iopub.status.busy":"2026-09-21T13:51:23.205271Z","iopub.status.idle":"2026-09-21T13:51:23.220116Z","shell.execute_reply":"2026-09-21T13:51:23.218634Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_