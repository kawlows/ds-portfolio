 torch.manual_seed(seed)","key":"rOv2VJ2toU"},{"type":"outputs","id":"iIlom3rDmLD5WFrJOlMHr","children":[],"key":"mgZM3iPPyl"}],"key":"LinqW2uwO6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"3. Random NumPy Array","key":"zDdvVo8v9X"}],"key":"ZlGmIxhsQi"}],"identifier":"id-3-random-numpy-array","label":"3. Random NumPy Array","html_id":"id-3-random-numpy-array","implicit":true,"key":"YCCqvKaFMu"},{"type":"paragraph","children":[{"type":"inlineCode","value":"np.random.randint(low, high, size)","key":"Fm3liZwDby"},{"type":"text","value":" draws from ","key":"O2mVgGzzOB"},{"type":"inlineCode","value":"low","key":"zbL31q44K9"},{"type":"text","value":" (inclusive) up to ","key":"p2yWSAA5hP"},{"type":"inlineCode","value":"high","key":"AwjfynKUxK"},{"type":"text","value":" (exclusive), which matches the \"0 (inclusive) and 5 (exclusive)\" wording of the instructions. The dtype is set to ","key":"VSXv3xkhex"},{"type":"inlineCode","value":"int32","key":"CIK5vS8o9a"},{"type":"text","value":" on purpose here — step 5 asks to change the tensor's dtype from ","key":"JUiZEpyZ70"},{"type":"inlineCode","value":"int32","key":"woKyx82ShL"},{"type":"text","value":" to ","key":"vbb70kO8OT"},{"type":"inlineCode","value":"int64","key":"GL6VsBfMtL"},{"type":"text","value":" later, and that only makes sense to demonstrate if the array (and the tensor made from it) is actually ","key":"l6ALgp8ndI"},{"type":"inlineCode","value":"int32","key":"ZovSWrnhQk"},{"type":"text","value":" to begin with.","key":"jHcYL8GDM9"}],"key":"qOo6MmtWHh"}],"key":"Gh0dzNNrx0"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.205492Z","iopub.status.busy":"2026-09-21T13:51:23.205271Z","iopub.status.idle":"2026-09-21T13:51:23.220116Z","shell.execute_reply":"2026-09-21T13:51:23.218634Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_