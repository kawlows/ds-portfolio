n with.","key":"opOZt9VNtk"}],"key":"tX6bcnqQx3"}],"identifier":"0c96f2c8","html_id":"0c96f2c8","key":"hka6SEDPtH"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.205492Z","iopub.status.busy":"2026-09-21T13:51:23.205271Z","iopub.status.idle":"2026-09-21T13:51:23.220116Z","shell.execute_reply":"2026-09-21T13:51:23.218634Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_seed(42)\narr = np.random.randint(0, 5, 6, dtype=np.int32)\nprint(arr)\nprint(arr.dtype)","key":"iRiMsgQgHh"},{"type":"outputs","id":"kGnSMSnzf7C9EOdfoqG3q","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[3 4 2 4 4 1]\nint32\n"},"children":[],"key":"DVl3fCkQa6"}],"key":"Yhrf4XDur3"}],"identifier":"be7b6042","html_id":"be7b6042","key":"aUxBfq4sAL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"4. Tensor from the NumPy Array","key":"keHP9Py03G"}],"key":"fgdPZjE6vv"}],"identifier":"id-4-tensor-from-the-numpy-array","label":"4. Tensor from the NumPy Array","html_id":"id-4-tensor-from-the-numpy-array","implicit":true,"key":"aWFfaqzNiG"},{"type":"paragraph","children":[{"type":"inlineCode","value":"torch.from_numpy()","key":"Fii5bf1M22"},{"type":"text","value":" wraps the existing array without copying it, and it carries the array's dtype over — so ","key":"q83YSVf5yB"},{"type":"inlineCode","value":"x","key":"mfiXqcw8MR"},{"type":"text","value":" starts out as an ","key":"RMqA7xKpbn"},{"type":"inlineCode","value":"int32","key":"b7gw3pWeIq"},{"type":"text","value":" tensor, matching ","key":"T2LX1OK2Iw"},{"type":"inlineCode","value":"arr","key":"HeunwxqKCN"},{"type":"text","value":".","key":"WQIOwZJkoO"}],"key":"r3LI5H2ezF"}],"identifier":"3d133d1c","html_id":"3d133d1c","key":"OM9hBOqdbw"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.222575Z","iopub.status.busy":"2026-09-21T13:51:23.222287Z","iopub.status.idle":"2026-09-21T13:51:23.228198Z","shell.execute_reply":"2026-09-21T13:51:23.227266Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x = torch.from_numpy(arr)\nprint(x)\nprint(x.dtype)","key":"ePn4mJcJFa"},{"type":"outputs","id":"I313IGJnu4tkoatISUiSC","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([3, 4, 2, 4, 4, 1], dtype=torch.int32)\ntorch.int32\n"},"children":[],"key":"IEIwEqsCWO"}],"key":"L5wnFGxzBn"}],"identifier":"96bce3ca","html_id":"96bce3ca","key":"mlR4QogU0o"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"5. Changing the dtype","key":"PLhEufaAym"}],"key":"O14dsDsXXv"}],"identifier":"id-5-changing-the-dtype","label":"5. Changing the dtype","html_id":"id-5-changing-the-dtype","implicit":true,"key":"cJPO1zP7Pb"},{"type":"paragraph","children":[{"type":"text","value":"As the notebook's earlier section on dtypes points out, ","key":"RkxUd9dzCH"},{"type":"inlineCode","value":"x = torch.tensor(x, dtype=torch.type)","key":"QCmNCBuaJN"},{"type":"text","value":" is the wrong way to do this — it triggers a tensor-cloning warning. The correct approach is the ","key":"UaXKIp2osL"},{"type":"inlineCode","value":".type()","key":"ZIptogpzRp"},{"type":"text","value":" method, which returns a new tensor cast to the requested dtype.","key":"hFcZBHls8e"}],"key":"bk2ugU1yg7"}],"identifier":"4ea0df70","html_id":"4ea0df70","key":"KlEWczZHE4"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.230724Z","iopub.status.busy":"2026-09-21T13:51:23.230487Z","iopub.status.idle":"2026-09-21T13:51:23.236280Z","shell.execute_reply":"2026-09-21T13:51:23.235082Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x = x.type(torch.int64)\nprint(x)\nprint(x.dtype)","key":"iCxEvMQJbt"},{"type":"outputs","id":"wkx9B-T4ySTsz-SyeYP21","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([3, 4, 2, 4, 4, 1])\ntorch.int64\n"},"children":[],"key":"hWHFkRH8o2"}],"key":"V3tVOagRk7"}],"identifier":"366ee701","html_id":"366ee701","key":"Y62pWCmQuM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"6. Reshaping into 3×2","key":"J3snvZOx4j"}],"key":"TTtMSTauUp"}],"identifier":"id-6-reshaping-into-3-2","label":"6. Reshaping into 3×2","html_id":"id-6-reshaping-into-3-2","implicit":true,"key":"scRis9i8I1"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x","key":"X06HG0Y0Te"},{"type":"text","value":" has 6 elements, so it can be reshaped into any shape whose dimensions multiply to 6 — 3 rows by 2 columns in this case. Either ","key":"cu5lVeNtIy"},{"type":"inlineCode","value":".view()","key":"uMaHZR4SoH"},{"type":"text","value":" or ","key":"Ishc8oMOxK"},{"type":"inlineCode","value":".reshape()","key":"nPw8ARwCbF"},{"type":"text","value":" works here since ","key":"X5m7FaK75z"},{"type":"inlineCode","value":"x","key":"dwhmsByktx"},{"type":"text","value":" is contiguous in memory; ","key":"rw6CjXoqpT"},{"type":"inlineCode","value":".reshape()","key":"TqOYmdtVLJ"},{"type":"text","value":" is used below since it also falls back gracefully to making a copy on tensors where ","key":"UftIDnIFPR"},{"type":"inlineCode","value":".view()","key":"IpDxkH0GxG"},{"type":"text","value":" would raise an error.","key":"ggQ8ZNAonU"}],"key":"bIH1eVKFmw"}],"identifier":"a06d0a63","html_id":"a06d0a63","key":"zyLVhWWf29"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.238109Z","iopub.status.busy":"2026-09-21T13:51:23.237900Z","iopub.status.idle":"2026-09-21T13:51:23.242803Z","shell.execute_reply":"2026-09-21T13:51:23.241702Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x = x.reshape(3, 2)\nprint(x)\nprint(x.shape)","key":"vDHCZxXx3h"},{"type":"outputs","id":"jCmSVWff-zRaEg6gCDsNa","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[3, 4],\n        [2, 4],\n        [4, 1]])\ntorch.Size([3, 2])\n"},"children":[],"key":"s581VD7NJa"}],"key":"qfLxgM8lEC"}],"identifier":"65801d07","html_id":"65801d07","key":"XELuufaR26"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"7. Right-Hand Column","key":"JGbGwIIOsA"}],"key":"C9wJz4zTfS"}],"identifier":"id-7-right-hand-column","label":"7. Right-Hand Column","html_id":"id-7-right-hand-column","implicit":true,"key":"G9fg67cWQS"},{"type":"paragraph","children":[{"type":"text","value":"Standard NumPy-style slicing carries over to tensors: ","key":"YeTWElrhY3"},{"type":"inlineCode","value":"x[:, 1]","key":"eUvZ12iW6p"},{"type":"text","value":" takes every row and column index 1, which is the second (right-hand) column.","key":"UBVHc2kkLS"}],"key":"UA0WuAp1up"}],"identifier":"0d47c039","html_id":"0d47c039","key":"x4FW3u5Qw2"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.244776Z","iopub.status.busy":"2026-09-21T13:51:23.244620Z","iopub.status.idle":"2026-09-21T13:51:23.249607Z","shell.execute_reply":"2026-09-21T13:51:23.248659Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"right_col = x[:, 1]\nprint(right_col)","key":"q3oo6E0SnI"},{"type":"outputs","id":"DVdLMm5UhM_nCES5E9COH","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([4, 4, 1])\n"},"children":[],"key":"MePrQF0dON"}],"key":"U9J6VEumoJ"}],"identifier":"cf3cdf51","html_id":"cf3cdf51","key":"wrNjPCbguF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"8. Squared Values, Without Changing ","key":"Oy57cs8Flf"},{"type":"inlineCode","value":"x","key":"yNXi5dvPAB"}],"key":"pq4PweDrwq"}],"identifier":"id-8-squared-values-without-changing-x","label":"8. Squared Values, Without Changing x","html_id":"id-8-squared-values-without-changing-x","implicit":true,"key":"wX9YBWfwnl"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x.pow(2)","key":"tFwgrwDlXV"},{"type":"text","value":" (equivalently ","key":"RtzV5UoIvh"},{"type":"inlineCode","value":"x ** 2","key":"NBsxMfKDjw"},{"type":"text","value":" or ","key":"NmelSCzKVz"},{"type":"inlineCode","value":"torch.square(x)","key":"xbanPQzNVY"},{"type":"text","value":") returns a new tensor and leaves ","key":"nxae1Gcl5u"},{"type":"inlineCode","value":"x","key":"izkqC7nB1U"},{"type":"text","value":" untouched. The in-place version, ","key":"bSuDYj1jLp"},{"type":"inlineCode","value":"x.pow_(2)","key":"wzWlN34n9v"},{"type":"text","value":", would overwrite ","key":"h3YykWn5i7"},{"type":"inlineCode","value":"x","key":"Mm4kez1kqO"},{"type":"text","value":", which is exactly what the instructions say not to do — printing ","key":"l0Q95kF1rv"},{"type":"inlineCode","value":"x","key":"KWsapz5yxj"},{"type":"text","value":" again afterward confirms it is still the original 3×2 tensor.","key":"j9Es3L20GE"}],"key":"K4OIIxmtRX"}],"identifier":"0febe12f","html_id":"0febe12f","key":"qQ4csB3lLl"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.251544Z","iopub.status.busy":"2026-09-21T13:51:23.251363Z","iopub.status.idle":"2026-09-21T13:51:23.256452Z","shell.execute_reply":"2026-09-21T13:51:23.255431Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x_squared = x.pow(2)\nprint(\"Squared:\")\nprint(x_squared)\n\nprint(\"\\nx is unchanged:\")\nprint(x)","key":"c6i8l6Agfe"},{"type":"outputs","id":"74eddIjVHEXhi6Uvy7fhW","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Squared:\ntensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\nx is unchanged:\ntensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n"},"children":[],"key":"xVJvnLAJ5b"}],"key":"VoBeuyyURD"}],"identifier":"0ab79adf","html_id":"0ab79adf","key":"x5BhYhljys"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"9. Building ","key":"h2af7T99BU"},{"type":"inlineCode","value":"y","key":"CEYE26wwJX"},{"type":"text","value":" for Matrix Multiplication","key":"N4Vqbx0Nd9"}],"key":"EGB7ENOWfA"}],"identifier":"id-9-building-y-for-matrix-multiplication","label":"9. Building y for Matrix Multiplication","html_id":"id-9-building-y-for-matrix-multiplication","implicit":true,"key":"UXJKMppJHR"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x","key":"JAVerGI7rH"},{"type":"text","value":" is (3, 2). For ","key":"eBl9duJ6Sp"},{"type":"inlineCode","value":"x @ y","key":"Jlae1f6UDU"},{"type":"text","value":" to be valid, ","key":"RS1Fh6hYE5"},{"type":"inlineCode","value":"y","key":"qMEnOHDfxF"},{"type":"text","value":"'s first dimension has to match ","key":"c0Cd9ApOAC"},{"type":"inlineCode","value":"x","key":"xN0suuqG8x"},{"type":"text","value":"'s second dimension, i.e. 2 rows. The instructions also ask for the same number of elements as ","key":"wE5SEAQhWd"},{"type":"inlineCode","value":"x","key":"KcTuQhfouC"},{"type":"text","value":", which is 6, so ","key":"SH4jKkf190"},{"type":"inlineCode","value":"y","key":"Cv22kn8JxS"},{"type":"text","value":" has to be (2, 3): 2 rows to satisfy matrix multiplication, times 3 columns to reach 6 elements. ","key":"YmXv3huk2i"},{"type":"inlineCode","value":"torch.randint(low, high, size)","key":"pHoUIFUZk4"},{"type":"text","value":" is the PyTorch equivalent of the NumPy call used for ","key":"qMWTL4Pj7n"},{"type":"inlineCode","value":"arr","key":"TDdF3DoSe2"},{"type":"text","value":" earlier, and the seed is reset to 42 right before it so this cell produces the same values on every run.","key":"vdhIA907sB"}],"key":"MPNHnWFtjQ"}],"identifier":"a5664249","html_id":"a5664249","key":"DVJiAHSsIH"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.258464Z","iopub.status.busy":"2026-09-21T13:51:23.258244Z","iopub.status.idle":"2026-09-21T13:51:23.265106Z","shell.execute_reply":"2026-09-21T13:51:23.263738Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_seed(42)\ny = torch.randint(0, 5, (2, 3))\nprint(y)\nprint(y.shape)","key":"f3M60xPU6M"},{"type":"outputs","id":"KxVIz4hPgkdcbiV7HEJPc","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[2, 2, 1],\n        [4, 1, 0]])\ntorch.Size([2, 3])\n"},"children":[],"key":"lnL5lJuQpt"}],"key":"kBfBrmnrnK"}],"identifier":"849420f2","html_id":"849420f2","key":"EL1eoerpjs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"10. Matrix Product of ","key":"aDQ37LqCi1"},{"type":"inlineCode","value":"x","key":"I3N23avqYY"},{"type":"text","value":" and ","key":"xNPxgHJ7jn"},{"type":"inlineCode","value":"y","key":"YdXBfoadNa"}],"key":"ToPAoWiKJG"}],"identifier":"id-10-matrix-product-of-x-and-y","label":"10. Matrix Product of x and y","html_id":"id-10-matrix-product-of-x-and-y","implicit":true,"key":"ZSSm9HAXlw"},{"type":"paragraph","children":[{"type":"text","value":"With ","key":"YjhESjvjtP"},{"type":"inlineCode","value":"x","key":"KzX13ZATfj"},{"type":"text","value":" at (3, 2) and ","key":"nLAIcEYEno"},{"type":"inlineCode","value":"y","key":"aoceRpRSIM"},{"type":"text","value":" at (2, 3), ","key":"JxPSmESDyd"},{"type":"inlineCode","value":"torch.mm(x, y)","key":"PEMJ3OHLP9"},{"type":"text","value":" (equivalently ","key":"P1pw954a2i"},{"type":"inlineCode","value":"x @ y","key":"vaOLAPktOh"},{"type":"text","value":" or ","key":"yNfljJYNeP"},{"type":"inlineCode","value":"x.mm(y)","key":"XVjz1UOjlW"},{"type":"text","value":") produces a (3, 3) result, following the same rule covered earlier in the notebook: an (a, b) tensor times a (b, c) tensor gives an (a, c) tensor.","key":"aJ7aogoO4h"}],"key":"AEbslsYDTf"}],"identifier":"30f4afd6","html_id":"30f4afd6","key":"y8FfV3rcBT"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.267044Z","iopub.status.busy":"2026-09-21T13:51:23.266853Z","iopub.status.idle":"2026-09-21T13:51:23.272115Z","shell.execute_reply":"2026-09-21T13:51:23.270988Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"product = torch.mm(x, y)\nprint(product)\nprint(product.shape)","key":"ygtG6oHNct"},{"type":"outputs","id":"YSQ-yyDQWIPqZMAHN--ur","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\ntorch.Size([3, 3])\n"},"children":[],"key":"rhhhHPDZWQ"}],"key":"zJN6iyRj1Z"}],"identifier":"b7c79870","html_id":"b7c79870","key":"htGYxRtiyk"}],"key":"AqiJFIFhuC"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Laboratory Task 4 Linear Regression","url":"/laboratory-task-4-linear-regression","group":"Karl Michael Gaca Portfolio"},"next":{"title":"Laboratory Task 6 CNN Architecture","url":"/laboratory-task-6-cnn-architecture","group":"Karl Michael Gaca Portfolio"}}},"domain":"http://localhost:3000"}