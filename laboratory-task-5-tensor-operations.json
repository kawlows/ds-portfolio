_seed(seed)","key":"nbcfWwkUXc"},{"type":"outputs","id":"y_pkVLf8P_hk1iw0LWrYU","children":[],"key":"tsPCaPgBTN"}],"key":"uSoEWg2jIU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"3. Random NumPy Array","key":"FgLXc1IO4g"}],"key":"Zo5em63sQK"}],"identifier":"id-3-random-numpy-array","label":"3. Random NumPy Array","html_id":"id-3-random-numpy-array","implicit":true,"key":"LdBuw3f58h"},{"type":"paragraph","children":[{"type":"inlineCode","value":"np.random.randint(low, high, size)","key":"juA442crNo"},{"type":"text","value":" draws from ","key":"w0gcxPKAbD"},{"type":"inlineCode","value":"low","key":"Oe6rsKAgTo"},{"type":"text","value":" (inclusive) up to ","key":"QpGvgay3Q8"},{"type":"inlineCode","value":"high","key":"r95RimW21p"},{"type":"text","value":" (exclusive), which matches the \"0 (inclusive) and 5 (exclusive)\" wording of the instructions. The dtype is set to ","key":"DKKozZpDiJ"},{"type":"inlineCode","value":"int32","key":"aJDPmfMzXN"},{"type":"text","value":" on purpose here — step 5 asks to change the tensor's dtype from ","key":"rZPxSh7z20"},{"type":"inlineCode","value":"int32","key":"oV1UO9EWUc"},{"type":"text","value":" to ","key":"OwbOd8Ip83"},{"type":"inlineCode","value":"int64","key":"H3M5Wkxslj"},{"type":"text","value":" later, and that only makes sense to demonstrate if the array (and the tensor made from it) is actually ","key":"UzhSYf7Up7"},{"type":"inlineCode","value":"int32","key":"QiLoZmH2Ht"},{"type":"text","value":" to begin with.","key":"GLwFEvpAGf"}],"key":"gu70agL14o"}],"key":"TIbAKPKVi9"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.205492Z","iopub.status.busy":"2026-09-21T13:51:23.205271Z","iopub.status.idle":"2026-09-21T13:51:23.220116Z","shell.execute_reply":"2026-09-21T13:51:23.218634Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_seed(42)\narr = np.random.randint(0, 5, 6, dtype=np.int32)\nprint(arr)\nprint(arr.dtype)","key":"GqnHeX7dJS"},{"type":"outputs","id":"sVPwgFEjgHmIe-pnPtvl3","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[3 4 2 4 4 1]\nint32\n"},"children":[],"key":"FC2xG7YLiU"}],"key":"MXXObzYHvU"}],"key":"DPwEXViuoA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"4. Tensor from the NumPy Array","key":"Nu8xEp4i9B"}],"key":"HQhEn0dUej"}],"identifier":"id-4-tensor-from-the-numpy-array","label":"4. Tensor from the NumPy Array","html_id":"id-4-tensor-from-the-numpy-array","implicit":true,"key":"BeoIoTbFX6"},{"type":"paragraph","children":[{"type":"inlineCode","value":"torch.from_numpy()","key":"NovgjNZ9ry"},{"type":"text","value":" wraps the existing array without copying it, and it carries the array's dtype over — so ","key":"h18PbcPpFU"},{"type":"inlineCode","value":"x","key":"Ej9g16pvWB"},{"type":"text","value":" starts out as an ","key":"WqLtzL4CyI"},{"type":"inlineCode","value":"int32","key":"Mzzy2kbg1X"},{"type":"text","value":" tensor, matching ","key":"jrZ9T5YTDo"},{"type":"inlineCode","value":"arr","key":"zTQe0ybaA7"},{"type":"text","value":".","key":"XoYGRwAqZ5"}],"key":"kul6IpIPWD"}],"key":"PDGUAjQSjw"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.222575Z","iopub.status.busy":"2026-09-21T13:51:23.222287Z","iopub.status.idle":"2026-09-21T13:51:23.228198Z","shell.execute_reply":"2026-09-21T13:51:23.227266Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x = torch.from_numpy(arr)\nprint(x)\nprint(x.dtype)","key":"XFrRG0HSBd"},{"type":"outputs","id":"mWS-ZDu0-Ja0mE1vZ6PQN","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([3, 4, 2, 4, 4, 1], dtype=torch.int32)\ntorch.int32\n"},"children":[],"key":"zfFiR2OpKs"}],"key":"