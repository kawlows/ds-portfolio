dren":[{"type":"text","value":"10. Matrix Product of ","key":"kQ3FG2gzRK"},{"type":"inlineCode","value":"x","key":"yj1z7piqd7"},{"type":"text","value":" and ","key":"CO1fYusNkM"},{"type":"inlineCode","value":"y","key":"AqE5AVrhLq"}],"key":"QlR2864jSU"}],"identifier":"id-10-matrix-product-of-x-and-y","label":"10. Matrix Product of x and y","html_id":"id-10-matrix-product-of-x-and-y","implicit":true,"key":"Xo3MWP6Ttx"},{"type":"paragraph","children":[{"type":"text","value":"With ","key":"hwnnXe8hhj"},{"type":"inlineCode","value":"x","key":"NGK2c47n1x"},{"type":"text","value":" at (3, 2) and ","key":"xfmpBxqJxk"},{"type":"inlineCode","value":"y","key":"OM6ezSANx6"},{"type":"text","value":" at (2, 3), ","key":"AhMFwofJHG"},{"type":"inlineCode","value":"torch.mm(x, y)","key":"BnDrUddm2M"},{"type":"text","value":" (equivalently ","key":"Y8aUXaXuo0"},{"type":"inlineCode","value":"x @ y","key":"Gu2orl8nN4"},{"type":"text","value":" or ","key":"WMx2fYSaeE"},{"type":"inlineCode","value":"x.mm(y)","key":"ClsDU7SZqA"},{"type":"text","value":") produces a (3, 3) result, following the same rule covered earlier in the notebook: an (a, b) tensor times a (b, c) tensor gives an (a, c) tensor.","key":"UH12OUmwlQ"}],"key":"nxjksyRZwM"}],"key":"SF8rWqTb79"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.267044Z","iopub.status.busy":"2026-09-21T13:51:23.266853Z","iopub.status.idle":"2026-09-21T13:51:23.272115Z","shell.execute_reply":"2026-09-21T13:51:23.270988Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"product = torch.mm(x, y)\nprint(product)\nprint(product.shape)","key":"hmWP43c299"},{"type":"outputs","id":"nReTEIyvKAjhVPi5o8A7d","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\ntorch.Size([3, 3])\n"},"children":[],"key":"jpTFkhPFlV"}],"key":"tyaQPkXa1v"}],"key":"JCAhJox5VO"}],"key":"Ksq2Vvx