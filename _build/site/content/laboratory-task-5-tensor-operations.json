T"},{"type":"inlineCode","value":"x.pow_(2)","key":"EjDOSY0fJG"},{"type":"text","value":", would overwrite ","key":"UA8KIepUkv"},{"type":"inlineCode","value":"x","key":"nqCgEqIfAM"},{"type":"text","value":", which is exactly what the instructions say not to do — printing ","key":"NRynA6dYko"},{"type":"inlineCode","value":"x","key":"Wy7Hon2M4e"},{"type":"text","value":" again afterward confirms it is still the original 3×2 tensor.","key":"rF3WxR3YAv"}],"key":"N25wS45oLz"}],"key":"YZBAjfHao7"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.251544Z","iopub.status.busy":"2026-09-21T13:51:23.251363Z","iopub.status.idle":"2026-09-21T13:51:23.256452Z","shell.execute_reply":"2026-09-21T13:51:23.255431Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x_squared = x.pow(2)\nprint(\"Squared:\")\nprint(x_squared)\n\nprint(\"\\nx is unchanged:\")\nprint(x)","key":"nqTPHZyArv"},{"type":"outputs","id":"9Len8MGcibS2CVsSpuN-R","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Squared:\ntensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\nx is unchanged:\ntensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n"},"children":[],"key":"OFxFjjGohx"}],"key":"phnZTKyT2H"}],"key":"jWWp8QRPPJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"9. Building ","key":"olAXYsSmBz"},{"type":"inlineCode","value":"y","key":"oREDUHtSOa"},{"type":"text","value":" for Matrix Multiplication","key":"NeeHbbcofp"}],"key":"FjDRGFIOEb"}],"identifier":"id-9-building-y-for-matrix-multiplication","label":"9. Building y for Matrix Multiplication","html_id":"id-9-building-y-for-matrix-multiplication","implicit":true,"key":"MRxG36uk9O"},{"type":"paragraph","children":[{"type":"inlineCode","value":"x","key":"IVT14H1WvS"},{"type":"text","value":" is (3, 2). For ","key":"CC37p9elOo"},{"type":"inlineCode","value":"x @ y","key":"RjmqyIASiX"},{"type":"text","value":" to be valid, ","key":"HkrvK44shv"},{"type":"inlineCode","value":"y","key":"fmq3e2la5C"},{"type":"text","value":"'s first dimension has to match ","key":"QjvbBbKu21"},{"type":"inlineCode","value":"x","key":"fePojhYpE0"},{"type":"text","value":"'s second dimension, i.e. 2 rows. The instructions also ask for the same number of elements as ","key":"E8kcg9HnxJ"},{"type":"inlineCode","value":"x","key":"Y4njIali4s"},{"type":"text","value":", which is 6, so ","key":"MVCZf19Y7F"},{"type":"inlineCode","value":"y","key":"hlRO2iI3bz"},{"type":"text","value":" has to be (2, 3): 2 rows to satisfy matrix multiplication, times 3 columns to reach 6 elements. ","key":"OpIi5VVBhY"},{"type":"inlineCode","value":"torch.randint(low, high, size)","key":"R1Ma4QWyXV"},{"type":"text","value":" is the PyTorch equivalent of the NumPy call used for ","key":"jbELfaKI5G"},{"type":"inlineCode","value":"arr","key":"nXaOaum9AT"},{"type":"text","value":" earlier, and the seed is reset to 42 right before it so this cell produces the same values on every run.","key":"B3p8ZkfkVM"}],"key":"h98bmovlET"}],"key":"AWzFbuYazW"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.258464Z","iopub.status.busy":"2026-09-21T13:51:23.258244Z","iopub.status.idle":"2026-09-21T13:51:23.265106Z","shell.execute_reply":"2026-09-21T13:51:23.263738Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"set_seed(42)\ny = torch.randint(0, 5, (2, 3))\nprint(y)\nprint(y.shape)","key":"xL3wTBmJhj"},{"type":"outputs","id":"qzu8aYD1YarCoIee8A6hB","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[2, 2, 1],\n        [4, 1, 0]])\ntorch.Size([2, 3])\n"},"children":[],"key":"KNyssL6LqP"}],"key":"uvOG2RUptK"}],"key":"CsvGp31byU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"10. Matrix Product of ","key":"msDRNoRMHh"},{"type":"inlineCode","value":"x","key":"gc3dwarw3k"},{"type":"text","value":" and ","key":"PKTQ2OLmku"},{"type":"inlineCode","value":"y","key":"UFOwI0XZBe"}],"key":"QUpEj82uYO"}],"identifier":"id-10-matrix-product-of-x-and-y","label":"10. Matrix Product of x and y","html_id":"id-10-matrix-product-of-x-and-y","implicit":true,"key":"wVlsyRojDS"},{"type":"paragraph","children":[{"type":"text","value":"With ","key":"F97JrBCUuD"},{"type":"inlineCode","value":"x","key":"hKdbOr4tqP"},{"type":"text","value":" at (3, 2) and ","key":"iqpNCsZ72K"},{"type":"inlineCode","value":"y","key":"bMmeESsm7Q"},{"type":"text","value":" at (2, 3), ","key":"BSd3rhQKTk"},{"type":"inlineCode","value":"torch.mm(x, y)","key":"MTOr1KAu6y"},{"type":"text","value":" (equivalently ","key":"kkcpt8mgx7"},{"type":"inlineCode","value":"x @ y","key":"W0juohsKc6"},{"type":"text","value":" or ","key":"P7sV1mYkZ0"},{"type":"inlineCode","value":"x.mm(y)","key":"xb3RMGfqMz"},{"type":"text","value":") produces a (3, 3) result, following the same rule covered earlier in the notebook: an (a, b) tensor times a (b, c) tensor gives an (a, c) tensor.","key":"w2kEV9nnOU"}],"key":"FkhAdq6N9Z"}],"key":"n9NW7M2Wn9"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.267044Z","iopub.status.busy":"2026-09-21T13:51:23.266853Z","iopub.status.idle":"2026-09-21T13:51:23.272115Z","shell.execute_reply":"2026-09-21T13:51:23.270988Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"product = torch.mm(x, y)\nprint(product)\nprint(product.shape)","key":"WjzIaYwA0l"},{"type":"outputs","id":"MpdcBLHVCrw1zlNcLPto1","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\ntorch.Size([3, 3])\n"},"children":[],"key":"Fc8oWnpTsF"}],"key":"XvmG4bPXFE"}],"key":"xj6SoZGm7z"}],"key":"MfJIe5E5IR"},