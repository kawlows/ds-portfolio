,"children":[{"type":"inlineCode","value":"x","key":"x96TYP57k2"},{"type":"text","value":" has 6 elements, so it can be reshaped into any shape whose dimensions multiply to 6 — 3 rows by 2 columns in this case. Either ","key":"xYpCuXzmzn"},{"type":"inlineCode","value":".view()","key":"GPNFjZkqFc"},{"type":"text","value":" or ","key":"ZWp5sRzeQc"},{"type":"inlineCode","value":".reshape()","key":"QccscGhfPz"},{"type":"text","value":" works here since ","key":"GtvTil9mbM"},{"type":"inlineCode","value":"x","key":"RlCdHWAJQQ"},{"type":"text","value":" is contiguous in memory; ","key":"eB6eSQiCK9"},{"type":"inlineCode","value":".reshape()","key":"TsQYvxwtU8"},{"type":"text","value":" is used below since it also falls back gracefully to making a copy on tensors where ","key":"L2vnY7aj6M"},{"type":"inlineCode","value":".view()","key":"pk79VuL7rp"},{"type":"text","value":" would raise an error.","key":"jsMt68Hq1Y"}],"key":"lhFKOTiTkF"}],"key":"tmLuGpOIOK"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T13:51:23.238109Z","iopub.status.busy":"2026-09-21T13:51:23.237900Z","iopub.status.idle":"2026-09-21T13:51:23.242803Z","shell.execute_reply":"2026-09-21T13:51:23.241702Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"x = x.reshape(3, 2)\nprint(x)\nprint(x.shape)","key":"vXWQvx3gdx"},{"type":"outputs","id":"qekFpod9xNek2wO_sQKnG","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tensor([[3, 4],\n        [2, 4],\n        [4, 1]])\ntorch.Size([3, 2])\n"},"children":[],"key":"Sa7SOQYDPz"}],"key":"ICfRkAf8NJ"}],"key":"Es7hkuBUHK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"7. Right-Hand Column","key":"xcpQKyOGCz"}],"key":"l5gKqmfgyz"}],"identifier":"id-7-right-hand-column","label":"7. Right-Hand Column","html_id":"id-7-right-hand-column","implicit":true,"key":"tn4QwuM